local Core=require(game.ServerScriptService.HaxballLab.PhysicsCore2D)
local cases={{id="A_perpendicular",y=149,vx=0,vy=50,b=1},{id="B_oblique",y=149,vx=20,vy=50,b=1},{id="C_v10",y=150,vx=0,vy=10,b=1},{id="C_v20",y=150,vx=0,vy=20,b=1},{id="C_v40",y=150,vx=0,vy=40,b=1},{id="C_v50",y=150,vx=0,vy=50,b=1},{id="D_y140",y=140,vx=0,vy=20,b=1},{id="D_y148.5",y=148.5,vx=0,vy=20,b=1},{id="D_y155",y=155,vx=0,vy=20,b=1},{id="E_planeB0",y=149,vx=0,vy=50,b=0},{id="E_planeB0.5",y=149,vx=0,vy=50,b=.5},{id="E_planeB1",y=149,vx=0,vy=50,b=1},{id="E_outerB0",y=190,vx=0,vy=20,b=0,offset=-200,mask=63},{id="F_opposite",y=180,vx=0,vy=-20,b=1}}
local results={}
for _,c in ipairs(cases) do local w=Core.newWorld({useBounds=false,maxSubsteps=64});local d=Core.addDisc(w,{id="ball",kind="ball",x=100,y=c.y,vx=c.vx,vy=c.vy,radius=10,invMass=1,damping=.99,bCoef=.5,collisionGroup=1,collisionMask=63});Core.addPlane(w,{id="plane",normalX=0,normalY=-1,offset=c.offset or -170,bCoef=c.b,collisionGroup=32,collisionMask=c.mask or 1});local before={x=d.x,y=d.y,vx=d.vx,vy=d.vy};local _,events,n=Core.stepWorld(w,{});results[#results+1]={id=c.id,before=before,after={x=d.x,y=d.y,vx=d.vx,vy=d.vy},substeps=n,events=events} end
return results
