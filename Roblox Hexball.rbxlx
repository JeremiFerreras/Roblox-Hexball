</ProtectedString><bool name="Disabled">false</bool><Content name="LinkedSource"><null /></Content><token name="RunContext">0</token><string name="ScriptGuid">{A0C7EAD7-83CD-4188-802A-F78E94C43304}</string><BinaryString name="AttributesSerialize" /><SecurityCapabilities name="Capabilities">0</SecurityCapabilities><bool name="DefinesCapabilities">false</bool><UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId><string name="Name">Server</string><BinaryString name="SerializedOverrides" /><int64 name="SourceAssetId">-1</int64><SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString><UniqueId name="UniqueId">696819431a01660b0b0e295000000a28</UniqueId></Properties></Item><Item class="Folder" referent="RBXB5A90F18444D49FBA15C5CD47F0D2EB8"><Properties>
				<Content name="ExplorerIconContent">
					<null /></Content><Color3 name="IconTint">
					<R>0</R><G>0</G><B>0</B></Color3><BinaryString name="AttributesSerialize" /><SecurityCapabilities name="Capabilities">0</SecurityCapabilities><bool name="DefinesCapabilities">false</bool><UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId><string name="Name">HaxballLab</string><BinaryString name="SerializedOverrides" /><int64 name="SourceAssetId">-1</int64><SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString><UniqueId name="UniqueId">2a8c184ef8e375f00b0e7616000009b2</UniqueId></Properties><Item class="ModuleScript" referent="RBXDCA4C2942978456ABCD5CCF1734B2C0A"><Properties>
					<Content name="LinkedSource"><null /></Content><ProtectedString name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Profile = require(ReplicatedStorage:WaitForChild("HaxballLab"):WaitForChild("StadiumReference2D"))
local Physics2D = {}
Physics2D.MatchCore = require(script.Parent:WaitForChild("PhysicsCore2D"))

local P = Profile.PhysicsBaseline.active
local Solver = Profile.PhysicsBaseline.labSolver
Physics2D.Config = {
    tickRate = Profile.Simulation.tickRate.value,
    playerRadius = P.player.radius,
    playerInvMass = P.player.invMass,
    playerDamping = P.player.damping,
    playerBounce = P.player.bounce,
    playerAcceleration = P.player.acceleration,
    playerKickAcceleration = P.player.kickAcceleration,
    playerKickDamping = P.player.kickDamping,
    ballRadius = P.ball.radius,
    ballInvMass = P.ball.invMass,
    ballDamping = P.ball.damping,
    ballBounce = P.ball.bounce,
    kickStrength = P.player.kickStrength,
    kickback = P.player.kickback,
    kickRangeExtra = P.kickRangeExtra,
    fieldHalfWidth = Profile.Bounds.halfWidth,
    fieldHalfHeight = Profile.Bounds.halfHeight,
    collisionIterations = Solver.collisionIterations,
    maxCollisionSubsteps = Solver.maxSubsteps,
    collisionSubstepRadiusFraction = Solver.substepRadiusFraction,
}

local C = Physics2D.Config
local function clampMagnitude(x, y, maxMagnitude)
    local m = math.sqrt(x*x + y*y)
    if m &gt; maxMagnitude and m &gt; 0 then
        local scale = maxMagnitude / m
        return x * scale, y * scale
    end
    return x, y
end

local function newPlayer(id, x, y)
    return {
        id=id, x=x, y=y, vx=0, vy=0,
        radius=C.playerRadius, invMass=C.playerInvMass,
        damping=C.playerDamping, bounce=C.playerBounce,
    }
end

function Physics2D.newState()
    return {
        tick = 0,
        player = newPlayer(1, -80, 0),
        player2 = newPlayer(2, 0, 0),
        ball = { id=3, x=0, y=0, vx=0, vy=0, radius=C.ballRadius, invMass=C.ballInvMass, damping=C.ballDamping, bounce=C.ballBounce },
        score = { red = 0, blue = 0 },
    }
end

local function resolveDiscs(a, b)
    local dx, dy = a.x - b.x, a.y - b.y
    local d2 = dx*dx + dy*dy
    local radii = a.radius + b.radius
    if d2 &gt; radii*radii then return nil end

    local d = math.sqrt(d2)
    local nx, ny
    if d &gt; 1e-8 then
        nx, ny = dx/d, dy/d
    else
        local aId, bId = a.id or 1, b.id or 2
        nx, ny = aId &lt;= bId and -1 or 1, 0
    end

    local penetration = math.max(0, radii - d)
    local invSum = a.invMass + b.invMass
    if invSum &lt;= 0 then
        return {
            normalX=nx, normalY=ny, penetration=penetration,
            correctionA=0, correctionB=0, normalSpeedBefore=0, impulse=0,
        }
    end

    local moveA = penetration * (a.invMass / invSum)
    local moveB = penetration * (b.invMass / invSum)
    a.x, a.y = a.x + nx*moveA, a.y + ny*moveA
    b.x, b.y = b.x - nx*moveB, b.y - ny*moveB

    local rvx, rvy = a.vx - b.vx, a.vy - b.vy
    local normalSpeed = rvx*nx + rvy*ny
    local impulse = 0
    if normalSpeed &lt; 0 then
        local restitution = math.min(a.bounce, b.bounce)
        impulse = -(1 + restitution) * normalSpeed / invSum
        a.vx, a.vy = a.vx + nx*impulse*a.invMass, a.vy + ny*impulse*a.invMass
        b.vx, b.vy = b.vx - nx*impulse*b.invMass, b.vy - ny*impulse*b.invMass
    end

    return {
        normalX=nx, normalY=ny, penetration=penetration,
        correctionA=moveA, correctionB=moveB,
        normalSpeedBefore=normalSpeed, impulse=impulse,
    }
end
Physics2D.resolveDiscs = resolveDiscs

local function wall(d, halfW, halfH)
    local minX, maxX = -halfW + d.radius, halfW - d.radius
    local minY, maxY = -halfH + d.radius, halfH - d.radius
    if d.x &lt; minX then d.x = minX; if d.vx &lt; 0 then d.vx = -d.vx*d.bounce end end
    if d.x &gt; maxX then d.x = maxX; if d.vx &gt; 0 then d.vx = -d.vx*d.bounce end end
    if d.y &lt; minY then d.y = minY; if d.vy &lt; 0 then d.vy = -d.vy*d.bounce end end
    if d.y &gt; maxY then d.y = maxY; if d.vy &gt; 0 then d.vy = -d.vy*d.bounce end end
end

local function advanceAxis(position,velocity,minBound,maxBound,dt,bounce)
    local remaining=dt
    local hits=0
    local guard=0
    while remaining&gt;1e-9 and guard&lt;256 do
        guard+=1
        local timeToWall=math.huge
        if velocity&gt;1e-9 then
            timeToWall=(maxBound-position)/velocity
        elseif velocity&lt; -1e-9 then
            timeToWall=(minBound-position)/velocity
        end
        if timeToWall&lt; -1e-8 then
            if position&lt;minBound then position=minBound else position=maxBound end
            timeToWall=0
        end
        if timeToWall&gt;remaining or timeToWall==math.huge then
            position+=velocity*remaining
            remaining=0
        else
            position+=velocity*timeToWall
            remaining-=timeToWall
            position=velocity&gt;0 and maxBound or minBound
            velocity=-velocity*bounce
            hits+=1
            if math.abs(velocity)&lt;=1e-9 then velocity=0; remaining=0 end
        end
    end
    if remaining&gt;1e-9 then position+=velocity*remaining end
    return position,velocity,hits
end

function Physics2D.step(state, input)
    state.tick+=1
    local p,b=state.player,state.ball
    local ix,iy=clampMagnitude(input.x or 0,input.y or 0,1)
    local accel=input.kick and C.playerKickAcceleration or C.playerAcceleration
    p.vx,p.vy=p.vx+ix*accel,p.vy+iy*accel

    local relX,relY=p.vx-b.vx,p.vy-b.vy
    local maxTravel=math.max(
        math.sqrt(p.vx*p.vx+p.vy*p.vy),
        math.sqrt(b.vx*b.vx+b.vy*b.vy),
        math.sqrt(relX*relX+relY*relY)
    )
    local featureSize=math.max(0.5,math.min(p.radius,b.radius)*C.collisionSubstepRadiusFraction)
    local substeps=math.clamp(math.ceil(maxTravel/featureSize),1,C.maxCollisionSubsteps)
    local info={substeps=substeps,playerBallContacts=0,ballWallBounces=0,playerWallBounces=0,lastPlayerBallContact=nil}
    local dt=1/substeps
    local minPX,maxPX=-C.fieldHalfWidth+p.radius,C.fieldHalfWidth-p.radius
    local minPY,maxPY=-C.fieldHalfHeight+p.radius,C.fieldHalfHeight-p.radius
    local minBX,maxBX=-C.fieldHalfWidth+b.radius,C.fieldHalfWidth-b.radius
    local minBY,maxBY=-C.fieldHalfHeight+b.radius,C.fieldHalfHeight-b.radius

    for substep=1,substeps do
        local localPlayerX,localPlayerY,localBallX,localBallY
        p.x,p.vx,localPlayerX=advanceAxis(p.x,p.vx,minPX,maxPX,dt,p.bounce)
        p.y,p.vy,localPlayerY=advanceAxis(p.y,p.vy,minPY,maxPY,dt,p.bounce)
        b.x,b.vx,localBallX=advanceAxis(b.x,b.vx,minBX,maxBX,dt,b.bounce)
        b.y,b.vy,localBallY=advanceAxis(b.y,b.vy,minBY,maxBY,dt,b.bounce)
        info.playerWallBounces+=localPlayerX+localPlayerY
        info.ballWallBounces+=localBallX+localBallY

        local contact=resolveDiscs(p,b)
        if contact and (contact.penetration&gt;0 or contact.impulse&gt;0) then
            info.playerBallContacts+=1
            info.lastPlayerBallContact={
                normalX=contact.normalX,normalY=contact.normalY,
                penetration=contact.penetration,correctionPlayer=contact.correctionA,
                correctionBall=contact.correctionB,normalSpeedBefore=contact.normalSpeedBefore,
                impulse=contact.impulse,substep=substep,
            }
        end
    end

    p.vx,p.vy=p.vx*p.damping,p.vy*p.damping
    b.vx,b.vy=b.vx*b.damping,b.vy*b.damping
    return state,info
end

function Physics2D.stepPlayerPair(state)
    state.tick += 1
    local a, b = state.player, state.player2
    local ax, ay, avx, avy = a.x, a.y, a.vx, a.vy
    local bx, by, bvx, bvy = b.x, b.y, b.vx, b.vy

    a.x, a.y = ax+avx, ay+avy
    b.x, b.y = bx+bvx, by+bvy

    local dx,dy=a.x-b.x,a.y-b.y
    local radiusSum=a.radius+b.radius
    if dx*dx+dy*dy &lt;= radiusSum*radiusSum then
        a.vx,a.vy=a.vx*a.damping,a.vy*a.damping
        b.vx,b.vy=b.vx*b.damping,b.vy*b.damping
        wall(a,C.fieldHalfWidth,C.fieldHalfHeight)
        wall(b,C.fieldHalfWidth,C.fieldHalfHeight)
        return state,resolveDiscs(a,b)
    end

    local rx, ry = ax-bx, ay-by
    local rvx, rvy = avx-bvx, avy-bvy
    local qa = rvx*rvx+rvy*rvy
    local qb = 2*(rx*rvx+ry*rvy)
    local qc = rx*rx+ry*ry-radiusSum*radiusSum
    local discriminant = qb*qb-4*qa*qc
    if qc &gt; 0 and qa &gt; 1e-12 and qb &lt; 0 and discriminant &gt;= 0 then
        local hitTime = (-qb-math.sqrt(discriminant))/(2*qa)
        if hitTime &gt;= 0 and hitTime &lt;= 1 then
            a.x, a.y = ax+avx*hitTime, ay+avy*hitTime
            b.x, b.y = bx+bvx*hitTime, by+bvy*hitTime
            a.vx, a.vy, b.vx, b.vy = avx, avy, bvx, bvy
            local contact=resolveDiscs(a,b)
            if contact then
                local remaining=1-hitTime
                a.x,a.y=a.x+a.vx*remaining,a.y+a.vy*remaining
                b.x,b.y=b.x+b.vx*remaining,b.y+b.vy*remaining
                a.vx,a.vy=a.vx*a.damping,a.vy*a.damping
                b.vx,b.vy=b.vx*b.damping,b.vy*b.damping
                wall(a,C.fieldHalfWidth,C.fieldHalfHeight)
                wall(b,C.fieldHalfWidth,C.fieldHalfHeight)
                contact.swept=true
                contact.impactFraction=hitTime
            end
            return state,contact
        end
    end

    a.vx,a.vy=a.vx*a.damping,a.vy*a.damping
    b.vx,b.vy=b.vx*b.damping,b.vy*b.damping
    wall(a,C.fieldHalfWidth,C.fieldHalfHeight)
    wall(b,C.fieldHalfWidth,C.fieldHalfHeight)
    return state,nil
end

function Physics2D.stepThreeBody(state, iterationCount)
    state.tick += 1
    local p1,p2,ball=state.player,state.player2,state.ball
    for _,disc in {p1,p2,ball} do
        disc.x,disc.y=disc.x+disc.vx,disc.y+disc.vy
        disc.vx,disc.vy=disc.vx*disc.damping,disc.vy*disc.damping
        wall(disc,C.fieldHalfWidth,C.fieldHalfHeight)
    end

    local pairs={
        {key="player1-player2",a=p1,b=p2},
        {key="player1-ball",a=p1,b=ball},
        {key="player2-ball",a=p2,b=ball},
    }
    local iterations=math.clamp(iterationCount or C.collisionIterations,1,24)
    local initialNormalSpeeds={}
    local contactPairs={}
    local impacts={}
    for _,pair in ipairs(pairs) do
        local dx,dy=pair.a.x-pair.b.x,pair.a.y-pair.b.y
        local d2=dx*dx+dy*dy
        local radii=pair.a.radius+pair.b.radius
        local d=math.sqrt(d2)
        local nx,ny
        if d&gt;1e-8 then
            nx,ny=dx/d,dy/d
        else
            local aId,bId=pair.a.id or 1,pair.b.id or 2
            nx,ny=aId&lt;=bId and -1 or 1,0
        end
        local vn=(pair.a.vx-pair.b.vx)*nx+(pair.a.vy-pair.b.vy)*ny
        initialNormalSpeeds[pair.key]=vn
        if d2&lt;=radii*radii then
            table.insert(contactPairs,pair)
            impacts[pair.key]={
                maxPenetration=math.max(0,radii-d),correctionA=0,correctionB=0,
                normalX=nx,normalY=ny,normalSpeedBefore=vn,
                impulseTotal=0,peakImpulseIncrement=0,lastImpulse=0,resolutionCount=0,
            }
        end
    end

    local positionIterations=0
    for iteration=1,iterations do
        positionIterations=iteration
        local deltas={}
        for _,disc in {p1,p2,ball} do deltas[disc]={x=0,y=0} end
        local maxPenetration=0
        for _,pair in ipairs(pairs) do
            local dx,dy=pair.a.x-pair.b.x,pair.a.y-pair.b.y
            local distance=math.sqrt(dx*dx+dy*dy)
            local radii=pair.a.radius+pair.b.radius
            if distance&lt;radii then
                local nx,ny
                if distance&gt;1e-8 then nx,ny=dx/distance,dy/distance
                else
                    local aId,bId=pair.a.id or 1,pair.b.id or 2
                    nx,ny=aId&lt;=bId and -1 or 1,0
                end
                local penetration=radii-distance
                maxPenetration=math.max(maxPenetration,penetration)
                local invSum=pair.a.invMass+pair.b.invMass
                if invSum&gt;0 then
                    local ca=penetration*(pair.a.invMass/invSum)
                    local cb=penetration*(pair.b.invMass/invSum)
                    local da,db=deltas[pair.a],deltas[pair.b]
                    da.x+=nx*ca; da.y+=ny*ca
                    db.x-=nx*cb; db.y-=ny*cb
                    local impact=impacts[pair.key]
                    if impact then
                        impact.maxPenetration=math.max(impact.maxPenetration,penetration)
                        impact.correctionA=math.max(impact.correctionA,ca)
                        impact.correctionB=math.max(impact.correctionB,cb)
                        impact.normalX,impact.normalY=nx,ny
                    end
                end
            end
        end
        for disc,delta in deltas do disc.x+=delta.x; disc.y+=delta.y end
        if maxPenetration&lt;=1e-5 then break end
    end

    local velocityIterations=0
    local accumulated={}
    local targets={}
    for _,pair in ipairs(contactPairs) do
        accumulated[pair.key]=0
        local vn=initialNormalSpeeds[pair.key]
        targets[pair.key]=vn&lt;0 and -math.min(pair.a.bounce,pair.b.bounce)*vn or 0
    end
    for iteration=1,iterations do
        velocityIterations=iteration
        local maxViolation=0
        for orderIndex=1,#contactPairs do
            local pairIndex=iteration%2==1 and orderIndex or (#contactPairs-orderIndex+1)
            local pair=contactPairs[pairIndex]
            local dx,dy=pair.a.x-pair.b.x,pair.a.y-pair.b.y
            local distance=math.sqrt(dx*dx+dy*dy)
            local nx,ny
            if distance&gt;1e-8 then nx,ny=dx/distance,dy/distance
            else
                local aId,bId=pair.a.id or 1,pair.b.id or 2
                nx,ny=aId&lt;=bId and -1 or 1,0
            end
            local invSum=pair.a.invMass+pair.b.invMass
            if invSum&gt;0 then
                local vn=(pair.a.vx-pair.b.vx)*nx+(pair.a.vy-pair.b.vy)*ny
                local target=targets[pair.key] or 0
                local oldTotal=accumulated[pair.key]
                local newTotal=math.max(0,oldTotal+(target-vn)/invSum)
                local delta=newTotal-oldTotal
                if math.abs(delta)&gt;1e-12 then
                    accumulated[pair.key]=newTotal
                    pair.a.vx+=nx*delta*pair.a.invMass
                    pair.a.vy+=ny*delta*pair.a.invMass
                    pair.b.vx-=nx*delta*pair.b.invMass
                    pair.b.vy-=ny*delta*pair.b.invMass
                    local impact=impacts[pair.key]
                    if impact then
                        impact.impulseTotal=newTotal
                        impact.lastImpulse=delta
                        impact.peakImpulseIncrement=math.max(impact.peakImpulseIncrement,math.abs(delta))
                        impact.resolutionCount+=1
                        impact.normalX,impact.normalY=nx,ny
                    end
                end
            end
        end
        for _,pair in ipairs(contactPairs) do
            local dx,dy=pair.a.x-pair.b.x,pair.a.y-pair.b.y
            local distance=math.sqrt(dx*dx+dy*dy)
            local nx,ny
            if distance&gt;1e-8 then nx,ny=dx/distance,dy/distance
            else
                local aId,bId=pair.a.id or 1,pair.b.id or 2
                nx,ny=aId&lt;=bId and -1 or 1,0
            end
            local vn=(pair.a.vx-pair.b.vx)*nx+(pair.a.vy-pair.b.vy)*ny
            maxViolation=math.max(maxViolation,math.max(0,(targets[pair.key] or 0)-vn))
        end
        if maxViolation&lt;=1e-6 then break end
    end

    local residuals={}
    local maxResidual=0
    for _,pair in ipairs(pairs) do
        local dx,dy=pair.a.x-pair.b.x,pair.a.y-pair.b.y
        local distance=math.sqrt(dx*dx+dy*dy)
        local residual=math.max(0,pair.a.radius+pair.b.radius-distance)
        residuals[pair.key]=residual
        maxResidual=math.max(maxResidual,residual)
    end
    return state,impacts,residuals,maxResidual,math.max(positionIterations,velocityIterations)
end

function Physics2D.tryKick(state, facingX, facingY)
    local p, b = state.player, state.ball
    local dx, dy = b.x - p.x, b.y - p.y
    local d = math.sqrt(dx*dx + dy*dy)
    if d &gt; p.radius + b.radius + C.kickRangeExtra then return false end
    if d &gt; 1e-8 then dx, dy = dx/d, dy/d else dx, dy = facingX, facingY end
    if dx*dx + dy*dy &lt; 1e-8 then dx, dy = 1, 0 end
    b.vx, b.vy = b.vx + dx*C.kickStrength, b.vy + dy*C.kickStrength
    p.vx, p.vy = p.vx - dx*C.kickback, p.vy - dy*C.kickback
    return true
end

return Physics2D</ProtectedString><string name="ScriptGuid">{77A2A1DB-CD49-4933-92A7-8058653BB599}</string><BinaryString name="AttributesSerialize" /><SecurityCapabilities name="Capabilities">0</SecurityCapabilities><bool name="DefinesCapabilities">false</bool><UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId><string name="Name">Physics2D</string><BinaryString name="SerializedOverrides" /><int64 name="SourceAssetId">-1</int64><SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString><UniqueId name="UniqueId">2a8c184ef8e375f00b0e7616000009b3</UniqueId></Properties></Item><Item class="Script" referent="RBXA364B77C7A6947CFA269AB2A1B968906"><Properties>
					<ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local lab = ReplicatedStorage:WaitForChild("HaxballLab")
local remotes = lab.Remotes
local inputRemote = remotes.Input
local snapshotRemote = remotes.Snapshot
local commandRemote = remotes.DebugCommand
local inputStream = remotes:WaitForChild("InputStream")
local stateStream = remotes:WaitForChild("StateStream")
local controlRemote = remotes:WaitForChild("Control")
local NetCodec = require(lab:WaitForChild("NetCodec"))
local NetServer = require(script.Parent:WaitForChild("NetServer"))
local network = NetServer.new()
local lastAppliedMasks = {}
local debugEnabled = RunService:IsStudio()
local controlRequests = {}
local Physics2D = require(script.Parent:WaitForChild("Physics2D"))
local PhysicsCore2D = Physics2D.MatchCore
local ClassicStadium2D = require(script.Parent:WaitForChild("ClassicStadium2D"))
local StadiumProfile2D = require(lab:WaitForChild("StadiumReference2D"))
local MatchRules2D = require(script.Parent:WaitForChild("MatchRules2D"))
local LocalMatch2D = require(script.Parent:WaitForChild("LocalMatch2D"))
local localMatch
local matchId = 0
local LabRegression = require(script.Parent:WaitForChild("LabRegression"))
local debugState = script.Parent:WaitForChild("DebugState")

Players.CharacterAutoLoads = false
local state = Physics2D.newState()
local matchState = MatchRules2D.newMatch()
local currentInput = { x = 0, y = 0, kick = false }
local currentInputs = { [1] = currentInput }
local lastCoreKickInputs = {}
local touchingCoreBall = {}
local playerUserSlots = {}
local slotUserIds = {}
local lastKick = false
local facingX, facingY = 1, 0
local controlledPlayer = nil
local accumulator = 0
local stepDt = 1 / Physics2D.Config.tickRate
local recording = debugEnabled
local historyCapacity = 3600
local historyBuffer = {}
local historyWrite = 1
local historyCount = 0
local events = {}
local eventCapacity = 300
local pairMode = false
local crowdMode = false
local legacyMode = false
local speedRunRemaining = 0
local touchingBall = false
local touchingPlayers = false
local touchingCrowdPairs = {}
local metrics = {
	kickAttempts = 0,
	successfulKicks = 0,
	ballContacts = 0,
	ballWallBounces = 0,
	playerWallBounces = 0,
	lastKickSuccessTick = -1,
	playerContacts = 0,
	maxPlayerPenetration = 0,
	maxPlayerCorrection = 0,
	lastPlayerContactTick = -1,
	lastPlayerImpulse = 0,
	crowdContacts = 0,
	crowdContactsP1P2 = 0,
	crowdContactsP1Ball = 0,
	crowdContactsP2Ball = 0,
	crowdPeakPenetration = 0,
	crowdLastResidualPenetration = 0,
	crowdWorstResidualPenetration = 0,
	crowdLastSolverIterations = 0,
	crowdMaxSolverIterations = 0,
	lastCollisionSubsteps = 0,
	maxCollisionSubsteps = 0,
	regressionRan = false,
	regressionPassed = 0,
	regressionFailed = 0,
	regressionTotal = 0,
}
local function clearHistory()
	table.clear(historyBuffer)
	historyWrite, historyCount = 1, 0
end
local function logEvent(kind, data, eventTick)
	local event = data or {}
	event.kind = kind
	event.tick = eventTick or state.tick + 1
	table.insert(events, event)
	if #events &gt; eventCapacity then
		table.remove(events, 1)
	end
end
local function clearMetrics()
	metrics.kickAttempts = 0
	metrics.successfulKicks = 0
	metrics.ballContacts = 0
	metrics.ballWallBounces = 0
	metrics.playerWallBounces = 0
	metrics.lastKickSuccessTick = -1
	metrics.playerContacts = 0
	metrics.maxPlayerPenetration = 0
	metrics.maxPlayerCorrection = 0
	metrics.lastPlayerContactTick = -1
	metrics.lastPlayerImpulse = 0
	metrics.crowdContacts = 0
	metrics.crowdContactsP1P2 = 0
	metrics.crowdContactsP1Ball = 0
	metrics.crowdContactsP2Ball = 0
	metrics.crowdPeakPenetration = 0
	metrics.crowdLastResidualPenetration = 0
	metrics.crowdWorstResidualPenetration = 0
	metrics.crowdLastSolverIterations = 0
	metrics.crowdMaxSolverIterations = 0
	metrics.lastCollisionSubsteps = 0
	metrics.maxCollisionSubsteps = 0
	metrics.regressionRan = false
	metrics.regressionPassed = 0
	metrics.regressionFailed = 0
	metrics.regressionTotal = 0
	table.clear(events)
	clearHistory()
	touchingBall = false
	touchingPlayers = false
	touchingCrowdPairs = {}
end
local function finite(n)
	return typeof(n) == "number" and n == n and math.abs(n) &lt; 1e6
end

local function setController(player)
	if controlledPlayer == nil then
		controlledPlayer = player
	end
	if not playerUserSlots[player.UserId] then
		for slot = 1, 10 do
			if slotUserIds[slot] == nil then
				playerUserSlots[player.UserId] = slot
				slotUserIds[slot] = player.UserId
				if state.players and state.players[slot] then
					state.players[slot].ownerUserId = player.UserId
				end
				break
			end
		end
	end
	if player.Character then
		player.Character:Destroy()
	end
end
Players.PlayerAdded:Connect(setController)
for _, player in Players:GetPlayers() do
	setController(player)
end
Players.PlayerRemoving:Connect(function(player)
	controlRequests[player.UserId] = nil
	local slot = playerUserSlots[player.UserId]
	if slot then
		network:release(slot)
		playerUserSlots[player.UserId] = nil
		slotUserIds[slot] = nil
		currentInputs[slot] = { x = 0, y = 0, kick = false }
		lastCoreKickInputs[slot] = nil
		touchingCoreBall[slot] = nil
		if state.players and state.players[slot] then
			state.players[slot].ownerUserId = nil
		end
	end
	if player == controlledPlayer then
		controlledPlayer = nil
		for _, candidate in Players:GetPlayers() do
			if candidate ~= player then
				controlledPlayer = candidate
				break
			end
		end
		currentInput = { x = 0, y = 0, kick = false }
		if state.coreWorld then
			-- Removing the controller must not clear input owned by a different slot.
			currentInput = currentInputs[1] or currentInput
		else
			currentInputs[1] = currentInput
		end
		lastKick = false
		if state.players then
			local newSlot = controlledPlayer and playerUserSlots[controlledPlayer.UserId]
			if newSlot and state.players[newSlot] then
				state.players[newSlot].ownerUserId = controlledPlayer.UserId
			end
		elseif state.player then
			state.player.ownerUserId = controlledPlayer and controlledPlayer.UserId or nil
		end
	end
end)

local function allocateInput(playerSlot, x, y, kick)
	if not finite(x) or not finite(y) then
		return nil
	end
	local magnitude = math.sqrt(x * x + y * y)
	if magnitude &gt; 1 then
		x, y = x / magnitude, y / magnitude
	end
	local value = { x = x, y = y, kick = kick == true }
	local old = currentInputs[playerSlot] or { x = 0, y = 0, kick = false }
	if x ~= old.x or y ~= old.y or value.kick ~= old.kick then
		logEvent("input", { playerId = playerSlot, x = x, y = y, kick = value.kick })
	end
	currentInputs[playerSlot] = value
	return value
end
local function receiveInput(player, x, y, kick)
	local slot = playerUserSlots[player.UserId]
	if state.coreWorld then
		if slot then
			network:receive(slot, x, state.tick)
		end
		return
	end
	local slot = playerUserSlots[player.UserId]
	if not slot then
		return
	end
	if pairMode or crowdMode or legacyMode then
		if player ~= controlledPlayer then
			return
		end
		local value = allocateInput(1, x, y, kick)
		if value then
			currentInput = value
		end
		if value and x * x + y * y &gt; 0.01 then
			local magnitude = math.sqrt(x * x + y * y)
			facingX, facingY = x / magnitude, y / magnitude
		end
		return
	end
	local value = allocateInput(slot, x, y, kick)
	if value and slot == 1 then
		currentInput = value
	end
end
inputRemote.OnServerEvent:Connect(receiveInput)
inputStream.OnServerEvent:Connect(receiveInput)

local function speed(d)
	return math.sqrt(d.vx * d.vx + d.vy * d.vy)
end
local function makeCoreState()
	local legacy = Physics2D.newState()
	local world = PhysicsCore2D.newWorld({
		tickRate = Physics2D.Config.tickRate,
		fieldHalfWidth = Physics2D.Config.fieldHalfWidth,
		fieldHalfHeight = Physics2D.Config.fieldHalfHeight,
		useBounds = false,
		solverMode = "haxballDiscrete",
	})
	-- Preserve stadium order: ball, static posts, then ten player discs.
	local ball = PhysicsCore2D.addDisc(world, {
		id = "ball",
		kind = "ball",
		x = 0,
		y = 0,
		radius = Physics2D.Config.ballRadius,
		invMass = Physics2D.Config.ballInvMass,
		damping = Physics2D.Config.ballDamping,
		traceMotion = true,
		bCoef = Physics2D.Config.ballBounce,
		kickable = true,
		collisionGroup = ClassicStadium2D.Groups.ball,
	})
	local stadiumGeometry = ClassicStadium2D.install(PhysicsCore2D, world)
	local spawnPoints = table.clone(StadiumProfile2D.SpawnPoints)
	local players = {}
	local playerCollisionMasks = {}
	for slot = 1, 10 do
		local position = spawnPoints[slot]
		local disc = PhysicsCore2D.addDisc(world, {
			id = slot,
			kind = "player",
			team = slot &lt;= 5 and "red" or "blue",
			x = position.x,
			y = position.y,
			radius = Physics2D.Config.playerRadius,
			invMass = Physics2D.Config.playerInvMass,
			damping = Physics2D.Config.playerDamping,
			kickDamping = Physics2D.Config.playerKickDamping,
			bCoef = Physics2D.Config.playerBounce,
			acceleration = Physics2D.Config.playerAcceleration,
			kickAcceleration = Physics2D.Config.playerKickAcceleration,
			kickStrength = Physics2D.Config.kickStrength,
			kickback = Physics2D.Config.kickback,
			kickRangeExtra = Physics2D.Config.kickRangeExtra,
			collisionGroup = slot &lt;= 5 and ClassicStadium2D.Groups.red or ClassicStadium2D.Groups.blue,
			collisionMask = StadiumProfile2D.CollisionMasks.player,
		})
		disc.ownerUserId = slotUserIds[slot]
		players[slot] = disc
		playerCollisionMasks[slot] = disc.collisionMask
	end
	return {
		tick = 0,
		player = players[1],
		player2 = players[6],
		players = players,
		ball = ball,
		score = legacy.score,
		coreWorld = world,
		stadiumGeometry = stadiumGeometry,
		spawnPoints = spawnPoints,
		playerCollisionMasks = playerCollisionMasks,
	}
end

local function newState(pairEnabled, crowdEnabled, legacyPhysicsEnabled, startWithKickoff)
	local useLegacy = pairEnabled == true or crowdEnabled == true or legacyPhysicsEnabled == true
	local new = useLegacy and Physics2D.newState() or makeCoreState()
	if not new.coreWorld then
		new.player.ownerUserId = controlledPlayer and controlledPlayer.UserId or nil
	end
	pairMode = pairEnabled == true
	crowdMode = crowdEnabled == true
	legacyMode = legacyPhysicsEnabled == true
	state = new
	matchId += 1
	localMatch = new.coreWorld and LocalMatch2D.attach(new, { startWithKickoff = startWithKickoff == true }) or nil
	matchState = localMatch and localMatch.match or MatchRules2D.newMatch()
	network:epoch(matchId, localMatch and localMatch.round or 0)
	lastAppliedMasks = {}
	currentInputs = {}
	for slot = 1, 10 do
		currentInputs[slot] = { x = 0, y = 0, kick = false }
	end
	currentInput = currentInputs[1]
	lastCoreKickInputs = {}
	touchingCoreBall = {}
	lastKick = false
	facingX, facingY = 1, 0
	accumulator = 0
	speedRunRemaining = 0
	clearMetrics()
	touchingCrowdPairs = {}
	return new
end
newState(false, false, false, true)
commandRemote.OnServerEvent:Connect(function(player, command)
	if not debugEnabled or player ~= controlledPlayer then
		return
	end
	if command == "reset" then
		newState(false, false, false, true)
		logEvent("scenarioReset", { scenario = "default" })
	elseif command == "setupKick" then
		local new = newState(false)
		new.player.x = -27
		logEvent("scenarioReset", { scenario = "kickFromRest", separation = 27 })
	elseif command == "setupWall" then
		local new = newState(false)
		new.ball.x = 0
		new.ball.y = 156
		new.ball.vy = 5
		logEvent("scenarioReset", { scenario = "ballWallBounce", ballY = new.ball.y, ballVy = new.ball.vy })
	elseif command == "setupGoalTest" then
		local new = newState(false)
		new.ball.x = 340
		new.ball.y = 0
		new.ball.vx = 12
		logEvent(
			"scenarioReset",
			{ scenario = "goalCrossing", ballX = new.ball.x, ballY = new.ball.y, ballVx = new.ball.vx }
		)
	elseif command == "setupSpeedRun" then
		local new = newState(false)
		new.player.x = -200
		new.player.y = 100
		currentInput = { x = 1, y = 0, kick = false }
		currentInputs[1] = currentInput
		speedRunRemaining = 120
		logEvent(
			"scenarioReset",
			{ scenario = "freeAccelerationRun", playerX = -200, playerY = 100, inputX = 1, inputY = 0 }
		)
	elseif command == "setupBallFastCrossing" then
		local new = newState(false, false, true)
		new.player.x = -40
		new.player.vx = 100
		new.ball.x = 0
		new.ball.y = 0
		logEvent("scenarioReset", { scenario = "fastPlayerBallCrossing", playerX = -40, playerVx = 100, ballX = 0 })
	elseif command == "setupBallFastDiagonal" then
		local new = newState(false, false, true)
		new.player.x = -40
		new.player.y = -40
		new.player.vx = 100
		new.player.vy = 100
		new.ball.x = 0
		new.ball.y = 0
		logEvent("scenarioReset", {
			scenario = "fastDiagonalPlayerBallCrossing",
			playerX = -40,
			playerY = -40,
			playerVx = 100,
			playerVy = 100,
			ballX = 0,
			ballY = 0,
		})
	elseif command == "setupMultiWall" then
		local new = newState(false, false, true)
		new.player.y = 100
		new.ball.x = 0
		new.ball.y = 0
		new.ball.vx = 3000
		logEvent("scenarioReset", { scenario = "multiWallBouncesInTick", ballX = 0, ballVx = 3000 })
	elseif command == "setupPairHeadOn" then
		local new = newState(true)
		new.player.x = -40
		new.player.vx = 2
		new.player2.x = 40
		new.player2.vx = -2
		logEvent("scenarioReset", { scenario = "playerHeadOn", p1x = -40, p1vx = 2, p2x = 40, p2vx = -2 })
	elseif command == "setupPairFastCrossing" then
		local new = newState(true)
		new.player.x = -40
		new.player.vx = 80
		new.player2.x = 40
		new.player2.vx = -80
		logEvent("scenarioReset", { scenario = "fastPairCrossing", p1x = -40, p1vx = 80, p2x = 40, p2vx = -80 })
	elseif command == "setupPairOblique" then
		local new = newState(true)
		new.player.x = -40
		new.player.y = -10
		new.player.vx = 2
		new.player2.x = 0
		new.player2.y = 15
		new.player2.vy = -0.8
		logEvent(
			"scenarioReset",
			{ scenario = "playerOblique", p1x = -40, p1y = -10, p1vx = 2, p2x = 0, p2y = 15, p2vy = -0.8 }
		)
	elseif command == "setupPairOverlap" then
		local new = newState(true)
		new.player.x = 0
		new.player.y = 0
		new.player2.x = 0
		new.player2.y = 0
		logEvent("scenarioReset", { scenario = "playerCoincidentCenters" })
	elseif command == "setupCrowdOverlap" then
		local new = newState(false, true)
		new.player.x = -14
		new.player2.x = 14
		new.ball.x = 0
		new.ball.y = 0
		logEvent("scenarioReset", { scenario = "threeDiscOverlap", p1x = -14, p2x = 14, ballX = 0 })
	elseif command == "setupCrowdApproach" then
		local new = newState(false, true)
		new.player.x = -32
		new.player.vx = 2
		new.player2.x = 32
		new.player2.vx = -2
		new.ball.x = 0
		new.ball.y = 0
		logEvent(
			"scenarioReset",
			{ scenario = "twoPlayersApproachBall", p1x = -32, p1vx = 2, p2x = 32, p2vx = -2, ballX = 0 }
		)
	elseif command == "runRegressionSuite" then
		local report = LabRegression.Run(Physics2D)
		metrics.regressionRan = true
		metrics.regressionPassed = report.passed
		metrics.regressionFailed = report.failed
		metrics.regressionTotal = report.total
		logEvent(
			"regressionSuiteCompleted",
			{ passed = report.passed, failed = report.failed, total = report.total, allPassed = report.allPassed }
		)
	elseif command == "toggleRecording" then
		recording = not recording
		logEvent("recordingChanged", { recording = recording })
	end
end)

local function snapshot()
	local p, p2, b = state.player, state.player2, state.ball
	local dx, dy = p.x - b.x, p.y - b.y
	local p2dx, p2dy = p.x - p2.x, p.y - p2.y
	local p2bdx, p2bdy = p2.x - b.x, p2.y - b.y
	local playerSnapshots = {}
	local redCount, blueCount = 0, 0
	if state.players then
		for slot, disc in ipairs(state.players) do
			if disc.team == "red" then
				redCount += 1
			elseif disc.team == "blue" then
				blueCount += 1
			end
			table.insert(playerSnapshots, {
				playerId = slot,
				team = disc.team,
				ownerUserId = disc.ownerUserId,
				x = disc.x,
				y = disc.y,
				vx = disc.vx,
				vy = disc.vy,
				speed = speed(disc),
				radius = disc.radius,
				collisionGroup = disc.collisionGroup,
				collisionMask = disc.collisionMask,
				ack = network.queues[slot] and network.queues[slot].ack or 0,
				kickHeld = disc.kickHeld,
				kickArmed = disc.kickArmed,
				kickCooldown = disc.kickCooldown,
				needsKickRelease = localMatch and localMatch.needsKickRelease[slot] or false,
				inputMask = lastAppliedMasks[slot] or 0,
			})
		end
	end
	return {
		tick = state.tick,
		gameTime = state.tick / Physics2D.Config.tickRate,
		matchId = matchId,
		round = localMatch and localMatch.round or 0,
		elapsedMatchTicks = localMatch and localMatch.elapsedTicks or 0,
		winner = matchState.winner,
		matchPhase = matchState.phase,
		pauseTicksRemaining = matchState.remainingTicks,
		kickoffTeam = matchState.kickoffTeam,
		lastGoal = matchState.lastGoal,
		lastTouch = matchState.lastTouch,
		player = { x = p.x, y = p.y, vx = p.vx, vy = p.vy, speed = speed(p), radius = p.radius },
		predictionParams = {
			acceleration = p.acceleration or Physics2D.Config.playerAcceleration,
			kickAcceleration = p.kickAcceleration or Physics2D.Config.playerKickAcceleration,
			damping = p.damping or Physics2D.Config.playerDamping,
			kickDamping = p.kickDamping or Physics2D.Config.playerDamping,
			maxSpeed = p.maxSpeed,
		},
		player2 = { x = p2.x, y = p2.y, vx = p2.vx, vy = p2.vy, speed = speed(p2), radius = p2.radius },
		players = playerSnapshots,
		playerCount = #playerSnapshots,
		redCount = redCount,
		blueCount = blueCount,
		ball = {
			x = b.x,
			y = b.y,
			vx = b.vx,
			vy = b.vy,
			speed = speed(b),
			radius = b.radius,
			collisionGroup = b.collisionGroup,
			collisionMask = b.collisionMask,
		},
		score = { red = state.score.red, blue = state.score.blue },
		ownerUserId = p.ownerUserId,
		physicsDiscCount = state.coreWorld and #state.coreWorld.discs or 0,
		input = { x = currentInput.x, y = currentInput.y, kick = currentInput.kick },
		separation = math.sqrt(dx * dx + dy * dy),
		playerSeparation = math.sqrt(p2dx * p2dx + p2dy * p2dy),
		player2BallSeparation = math.sqrt(p2bdx * p2bdx + p2bdy * p2bdy),
		touchingBall = not pairMode and math.sqrt(dx * dx + dy * dy) &lt;= p.radius + b.radius + 0.02,
		touchingPlayer2Ball = crowdMode and math.sqrt(p2bdx * p2bdx + p2bdy * p2bdy) &lt;= p2.radius + b.radius + 0.02,
		touchingPlayers = math.sqrt(p2dx * p2dx + p2dy * p2dy) &lt;= p.radius + p2.radius + 0.02,
		pairMode = pairMode,
		crowdMode = crowdMode,
		coreMode = state.coreWorld ~= nil,
		legacyMode = legacyMode,
		ballActive = not pairMode,
		metrics = table.clone(metrics),
		networkStats = table.clone(network.stats),
		debugEnabled = debugEnabled,
		profileId = state.stadiumGeometry and state.stadiumGeometry.profileId or "legacy",
		recording = recording,
		historySamples = historyCount,
	}
end
controlRemote.OnServerEvent:Connect(function(player, kind, nonce)
	local previous = controlRequests[player.UserId] or -100
	if state.tick - previous &lt; 15 then
		return
	end
	if kind == "ready" then
		controlRequests[player.UserId] = state.tick
		local slot = playerUserSlots[player.UserId]
		if slot and network.queues[slot] then
			network.queues[slot].pending = {}
		end
		local s = snapshot()
		s.resync = true
		snapshotRemote:FireClient(player, s)
	elseif kind == "ping" and type(nonce) == "number" and nonce % 1 == 0 and nonce &gt;= 0 and nonce &lt; 4294967296 then
		controlRequests[player.UserId] = state.tick
		controlRemote:FireClient(player, "pong", nonce, state.tick)
	end
end)
debugState.OnInvoke = function(request)
	local current = snapshot()
	if request == "regression" then
		return LabRegression.Run(Physics2D)
	end
	if request == "summary" then
		return {
			current = current,
			metrics = table.clone(metrics),
			eventCount = #events,
			historyCount = historyCount,
			recording = recording,
		}
	end
	local chronological = {}
	local limit = type(request) == "table" and math.clamp(request.limit or 600, 1, 1200) or 600
	local hasAfterTick = type(request) == "table" and type(request.afterTick) == "number"
	local afterTick = hasAfterTick and request.afterTick or -1
	local first = historyCount &lt; historyCapacity and 1 or historyWrite
	local skip = hasAfterTick and 0 or math.max(0, historyCount - limit)
	for i = skip + 1, historyCount do
		local index = ((first + i - 2) % historyCapacity) + 1
		local sample = historyBuffer[index]
		if sample and sample.tick &gt; afterTick then
			table.insert(chronological, table.clone(sample))
			if #chronological &gt;= limit then
				break
			end
		end
	end
	local eventCopies = {}
	for _, event in events do
		table.insert(eventCopies, table.clone(event))
	end
	return {
		current = current,
		metrics = table.clone(metrics),
		events = eventCopies,
		history = chronological,
		recording = recording,
	}
end

RunService.Heartbeat:Connect(function(dt)
	local publishState
	accumulator += dt
	local iterations = 0
	while accumulator &gt;= stepDt and iterations &lt; 8 do
		local p, p2, b = state.player, state.player2, state.ball
		local beforeBallVx, beforeBallVy = b.vx, b.vy
		local beforePlayerVx, beforePlayerVy = p.vx, p.vy
		local pairResolution = nil
		local crowdResiduals = nil
		local physicsStepInfo = nil
		local pairBeforeSeparation = math.sqrt((p.x - p2.x) ^ 2 + (p.y - p2.y) ^ 2)

		if pairMode then
			local _, resolution = Physics2D.stepPlayerPair(state)
			pairResolution = resolution
			local separation = math.sqrt((p.x - p2.x) ^ 2 + (p.y - p2.y) ^ 2)
			local nowTouching = separation &lt;= p.radius + p2.radius + 0.02
			if resolution then
				metrics.maxPlayerPenetration = math.max(metrics.maxPlayerPenetration, resolution.penetration)
				metrics.maxPlayerCorrection =
					math.max(metrics.maxPlayerCorrection, resolution.correctionA + resolution.correctionB)
				if resolution and not touchingPlayers and (nowTouching or resolution.swept == true) then
					metrics.playerContacts += 1
					metrics.lastPlayerContactTick = state.tick
					metrics.lastPlayerImpulse = resolution.impulse
					logEvent("playerPlayerContact", {
						separation = resolution.swept and (p.radius + p2.radius - resolution.penetration) or separation,
						postStepSeparation = separation,
						penetration = resolution.penetration,
						correctionA = resolution.correctionA,
						correctionB = resolution.correctionB,
						normalX = resolution.normalX,
						normalY = resolution.normalY,
						normalSpeedBefore = resolution.normalSpeedBefore,
						impulse = resolution.impulse,
						swept = resolution.swept == true,
						impactFraction = resolution.impactFraction,
						p1x = p.x,
						p1y = p.y,
						p1vx = p.vx,
						p1vy = p.vy,
						p2x = p2.x,
						p2y = p2.y,
						p2vx = p2.vx,
						p2vy = p2.vy,
					}, state.tick)
				end
			end
			touchingPlayers = nowTouching
		elseif crowdMode then
			local _, impacts, residuals, maxResidual, iterationsUsed =
				Physics2D.stepThreeBody(state, Physics2D.Config.collisionIterations)
			crowdResiduals = residuals
			metrics.crowdLastSolverIterations = iterationsUsed
			metrics.crowdMaxSolverIterations = math.max(metrics.crowdMaxSolverIterations, iterationsUsed)
			local pairDefinitions = {
				{ key = "player1-player2", a = p, b = p2, metric = "crowdContactsP1P2" },
				{ key = "player1-ball", a = p, b = b, metric = "crowdContactsP1Ball" },
				{ key = "player2-ball", a = p2, b = b, metric = "crowdContactsP2Ball" },
			}
			for _, definition in pairDefinitions do
				local dx, dy = definition.a.x - definition.b.x, definition.a.y - definition.b.y
				local separation = math.sqrt(dx * dx + dy * dy)
				local isTouching = separation &lt;= definition.a.radius + definition.b.radius + 0.02
				local impact = impacts[definition.key]
				if impact then
					metrics.crowdPeakPenetration = math.max(metrics.crowdPeakPenetration, impact.maxPenetration)
				end
				if isTouching and not touchingCrowdPairs[definition.key] then
					metrics.crowdContacts += 1
					metrics[definition.metric] += 1
					logEvent("threeDiscContact", {
						pair = definition.key,
						separation = separation,
						penetration = impact and impact.maxPenetration or 0,
						correctionA = impact and impact.correctionA or 0,
						correctionB = impact and impact.correctionB or 0,
						normalX = impact and impact.normalX or 0,
						normalY = impact and impact.normalY or 0,
						normalSpeedBefore = impact and impact.normalSpeedBefore or 0,
						impulseTotal = impact and impact.impulseTotal or 0,
						peakImpulseIncrement = impact and impact.peakImpulseIncrement or 0,
						lastImpulse = impact and impact.lastImpulse or 0,
						resolutionCount = impact and impact.resolutionCount or 0,
						residualPenetration = residuals[definition.key] or 0,
						p1x = p.x,
						p1y = p.y,
						p1vx = p.vx,
						p1vy = p.vy,
						p2x = p2.x,
						p2y = p2.y,
						p2vx = p2.vx,
						p2vy = p2.vy,
						ballX = b.x,
						ballY = b.y,
						ballVx = b.vx,
						ballVy = b.vy,
					}, state.tick)
				end
				touchingCrowdPairs[definition.key] = isTouching
			end
			metrics.crowdLastResidualPenetration = maxResidual
			metrics.crowdWorstResidualPenetration = math.max(metrics.crowdWorstResidualPenetration, maxResidual)
			touchingPlayers = touchingCrowdPairs["player1-player2"] == true
		elseif state.coreWorld then
			network:epoch(matchId, localMatch.round, state.tick)
			currentInputs = network:consume(state.tick + 1)
			if speedRunRemaining &gt; 0 then
				currentInputs[1] = { x = 1, y = 0, kick = false }
			end
			currentInput = currentInputs[1]
			local result = localMatch:step(currentInputs)
			for slot, input in pairs(result.inputs) do
				lastAppliedMasks[slot] = NetCodec.mask(input.x, input.y, input.kick)
			end
			network:epoch(matchId, localMatch.round, state.tick)
			local coreInputs, kickAttempts = result.inputs, {}
			for slot = 1, 10 do
				local input = coreInputs[slot] or {}
				if input.kick and not lastCoreKickInputs[slot] then
					table.insert(kickAttempts, slot)
				end
				lastCoreKickInputs[slot] = input.kick == true
			end
			local coreEvents, coreSubsteps = result.physicsEvents, result.substeps
			local stepInfo = {
				substeps = coreSubsteps,
				ballWallBounces = 0,
				playerWallBounces = 0,
				playerBallContacts = 0,
				lastPlayerBallContact = nil,
			}
			local acceptedKicks, currentTouches, contactsByPlayer = {}, {}, {}
			for _, event in ipairs(coreEvents) do
				if event.kind == "kick" then
					acceptedKicks[event.playerId] = true
					metrics.successfulKicks += 1
					metrics.lastKickSuccessTick = state.tick
					logEvent("kickApplied", {
						playerId = event.playerId,
						targetId = event.targetId,
						normalX = event.normalX,
						normalY = event.normalY,
					}, state.tick)
				elseif event.kind == "boundaryContact" then
					local count = event.count or 1
					if event.discId == "ball" then
						stepInfo.ballWallBounces += count
					elseif type(event.discId) == "number" then
						stepInfo.playerWallBounces += count
					end
				elseif
					event.kind == "planeContact"
					or event.kind == "segmentContact"
					or event.kind == "vertexContact"
				then
					if event.discId == "ball" then
						stepInfo.ballWallBounces += 1
					elseif type(event.discId) == "number" then
						stepInfo.playerWallBounces += 1
					end
				elseif event.kind == "discContact" then
					local playerId
					if event.discA == "ball" and type(event.discB) == "number" then
						playerId = event.discB
					elseif event.discB == "ball" and type(event.discA) == "number" then
						playerId = event.discA
					end
					if playerId then
						stepInfo.playerBallContacts += 1
						local nx, ny = event.normalX, event.normalY
						if event.discA == "ball" then
							nx, ny = -nx, -ny
						end
						local contact = {
							playerId = playerId,
							normalX = nx,
							normalY = ny,
							penetration = event.penetration,
							normalSpeedBefore = event.normalSpeedBefore,
							impulse = event.impulse,
						}
						stepInfo.lastPlayerBallContact = contact
						contactsByPlayer[playerId] = contact
						currentTouches[playerId] = true
					elseif type(event.discA) == "number" and type(event.discB) == "number" then
						metrics.playerContacts += 1
						metrics.lastPlayerContactTick = state.tick
						metrics.maxPlayerPenetration = math.max(metrics.maxPlayerPenetration, event.penetration or 0)
						metrics.lastPlayerImpulse = event.impulse or 0
						logEvent("playerPlayerContact", {
							playerA = event.discA,
							playerB = event.discB,
							normalX = event.normalX,
							normalY = event.normalY,
							penetration = event.penetration,
							normalSpeedBefore = event.normalSpeedBefore,
							impulse = event.impulse,
						}, state.tick)
					end
				end
			end
			metrics.kickAttempts += #kickAttempts
			for _, slot in ipairs(kickAttempts) do
				local accepted = acceptedKicks[slot] == true
				local actor = state.players[slot]
				local separation = math.sqrt((actor.x - b.x) ^ 2 + (actor.y - b.y) ^ 2)
				logEvent("kickAttempt", {
					playerId = slot,
					accepted = accepted,
					separation = separation,
					playerX = actor.x,
					playerY = actor.y,
					ballX = b.x,
					ballY = b.y,
				}, state.tick)
			end
			for slot, actor in ipairs(state.players) do
				local dx, dy = actor.x - b.x, actor.y - b.y
				local touching = math.sqrt(dx * dx + dy * dy) &lt;= actor.radius + b.radius + 0.02
				if currentTouches[slot] and not touchingCoreBall[slot] then
					metrics.ballContacts += 1
					local contact = contactsByPlayer[slot] or {}
					logEvent("playerBallContact", {
						playerId = slot,
						separation = actor.radius + b.radius - (contact.penetration or 0),
						normalX = contact.normalX,
						normalY = contact.normalY,
						normalSpeedBefore = contact.normalSpeedBefore,
						impulse = contact.impulse,
						playerX = actor.x,
						playerY = actor.y,
						ballX = b.x,
						ballY = b.y,
					}, state.tick)
				end
				touchingCoreBall[slot] = touching
			end
			for _, event in ipairs(result.ruleEvents) do
				logEvent(event.kind, table.clone(event), event.tick)
			end
			if result.roundChanged or result.phase == "goalPause" then
				touchingCoreBall = {}
				touchingBall = false
				lastCoreKickInputs = {}
			end
			physicsStepInfo = stepInfo
			if speedRunRemaining &gt; 0 then
				speedRunRemaining -= 1
				if speedRunRemaining == 0 then
					currentInput = { x = 0, y = 0, kick = false }
					currentInputs[1] = currentInput
					logEvent(
						"speedRunFinished",
						{ ticks = 120, playerX = p.x, playerVx = p.vx, playerSpeed = speed(p) },
						state.tick
					)
				end
			end
			metrics.lastCollisionSubsteps = stepInfo.substeps
			metrics.maxCollisionSubsteps = math.max(metrics.maxCollisionSubsteps, stepInfo.substeps)
			if stepInfo.ballWallBounces &gt; 0 then
				metrics.ballWallBounces += stepInfo.ballWallBounces
				logEvent("ballBoundaryBounce", {
					count = stepInfo.ballWallBounces,
					x = b.x,
					y = b.y,
					vx = b.vx,
					vy = b.vy,
					substeps = stepInfo.substeps,
				}, state.tick)
			end
			if stepInfo.playerWallBounces &gt; 0 then
				metrics.playerWallBounces += stepInfo.playerWallBounces
				logEvent("playerBoundaryBounce", {
					count = stepInfo.playerWallBounces,
					x = p.x,
					y = p.y,
					vx = p.vx,
					vy = p.vy,
					substeps = stepInfo.substeps,
				}, state.tick)
			end
			local separation = math.sqrt((p.x - b.x) ^ 2 + (p.y - b.y) ^ 2)
			local nowTouching = separation &lt;= p.radius + b.radius + 0.02
			touchingBall = nowTouching
		else
			if currentInput.kick and not lastKick then
				metrics.kickAttempts += 1
				local dx, dy = b.x - p.x, b.y - p.y
				local separation = math.sqrt(dx * dx + dy * dy)
				local accepted = Physics2D.tryKick(state, facingX, facingY)
				if accepted then
					metrics.successfulKicks += 1
					metrics.lastKickSuccessTick = state.tick + 1
				end
				logEvent("kickAttempt", {
					accepted = accepted,
					separation = separation,
					playerX = p.x,
					playerY = p.y,
					ballX = b.x,
					ballY = b.y,
				})
			end
			lastKick = currentInput.kick
			local _, stepInfo = Physics2D.step(state, currentInput)
			physicsStepInfo = stepInfo
			if speedRunRemaining &gt; 0 then
				speedRunRemaining -= 1
				if speedRunRemaining == 0 then
					currentInput = { x = 0, y = 0, kick = false }
					currentInputs[1] = currentInput
					logEvent(
						"speedRunFinished",
						{ ticks = 120, playerX = p.x, playerVx = p.vx, playerSpeed = speed(p) },
						state.tick
					)
				end
			end
			metrics.lastCollisionSubsteps = stepInfo.substeps
			metrics.maxCollisionSubsteps = math.max(metrics.maxCollisionSubsteps, stepInfo.substeps)
			if stepInfo.ballWallBounces &gt; 0 then
				metrics.ballWallBounces += stepInfo.ballWallBounces
				logEvent("ballBoundaryBounce", {
					count = stepInfo.ballWallBounces,
					x = b.x,
					y = b.y,
					vx = b.vx,
					vy = b.vy,
					substeps = stepInfo.substeps,
				}, state.tick)
			end
			if stepInfo.playerWallBounces &gt; 0 then
				metrics.playerWallBounces += stepInfo.playerWallBounces
				logEvent("playerBoundaryBounce", {
					count = stepInfo.playerWallBounces,
					x = p.x,
					y = p.y,
					vx = p.vx,
					vy = p.vy,
					substeps = stepInfo.substeps,
				}, state.tick)
			end
			local separation = math.sqrt((p.x - b.x) ^ 2 + (p.y - b.y) ^ 2)
			local nowTouching = separation &lt;= p.radius + b.radius + 0.02
			if stepInfo.playerBallContacts &gt; 0 and not touchingBall then
				metrics.ballContacts += 1
				local contact = stepInfo.lastPlayerBallContact or {}
				logEvent("playerBallContact", {
					separation = p.radius + b.radius - (contact.penetration or 0),
					postStepSeparation = separation,
					contactsThisTick = stepInfo.playerBallContacts,
					substep = contact.substep,
					substeps = stepInfo.substeps,
					normalX = contact.normalX,
					normalY = contact.normalY,
					normalSpeedBefore = contact.normalSpeedBefore,
					impulse = contact.impulse,
					penetration = contact.penetration,
					playerX = p.x,
					playerY = p.y,
					ballX = b.x,
					ballY = b.y,
				}, state.tick)
			end
			touchingBall = nowTouching
		end

		accumulator -= stepDt
		iterations += 1
		local current = recording and snapshot() or nil
		publishState = current
		if recording then
			historyBuffer[historyWrite] = {
				tick = current.tick,
				gameTime = current.gameTime,
				pairMode = pairMode,
				crowdMode = crowdMode,
				inputX = current.input.x,
				inputY = current.input.y,
				kick = current.input.kick,
				playerX = p.x,
				playerY = p.y,
				playerVx = p.vx,
				playerVy = p.vy,
				playerSpeed = current.player.speed,
				player2X = p2.x,
				player2Y = p2.y,
				player2Vx = p2.vx,
				player2Vy = p2.vy,
				player2Speed = current.player2.speed,
				players = current.players,
				ballX = b.x,
				ballY = b.y,
				ballVx = b.vx,
				ballVy = b.vy,
				ballSpeed = current.ball.speed,
				separation = current.separation,
				playerSeparation = current.playerSeparation,
				player2BallSeparation = current.player2BallSeparation,
				pairPenetration = pairResolution and pairResolution.penetration or 0,
				crowdContacts = metrics.crowdContacts,
				crowdResidual = metrics.crowdLastResidualPenetration,
				solverIterations = metrics.crowdLastSolverIterations,
				physicsSubsteps = physicsStepInfo and physicsStepInfo.substeps or 0,
				residualP1P2 = crowdResiduals and crowdResiduals["player1-player2"] or 0,
				residualP1Ball = crowdResiduals and crowdResiduals["player1-ball"] or 0,
				residualP2Ball = crowdResiduals and crowdResiduals["player2-ball"] or 0,
				pairNormalX = pairResolution and pairResolution.normalX or 0,
				pairNormalY = pairResolution and pairResolution.normalY or 0,
				pairImpulse = pairResolution and pairResolution.impulse or 0,
				touchingBall = current.touchingBall,
				touchingPlayers = current.touchingPlayers,
			}
			historyWrite = (historyWrite % historyCapacity) + 1
			historyCount = math.min(historyCapacity, historyCount + 1)
		end
	end
	if iterations &gt; 0 then
		local current = publishState or snapshot()
		network:publish(current, function(s)
			snapshotRemote:FireAllClients(s)
		end, function(b)
			stateStream:FireAllClients(b)
		end)
	end
end)
</ProtectedString><bool name="Disabled">false</bool><Content name="LinkedSource"><null /></Content><token name="RunContext">0</token><string name="ScriptGuid">{0030F6C4-73F1-454A-B044-9D42A15AE3E2}</string><BinaryString name="AttributesSerialize" /><SecurityCapabilities name="Capabilities">0</SecurityCapabilities><bool name="DefinesCapabilities">false</bool><UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId><string name="Name">LabServer</string><BinaryString name="SerializedOverrides" /><int64 name="SourceAssetId">-1</int64><SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString><UniqueId name="UniqueId">2a8c184ef8e375f00b0e7616000009b6</UniqueId></Properties></Item><Item class="BindableFunction" referent="RBX7FEC71678A8E4B0A894AEC02BB196B2B"><Properties>
					<BinaryString name="AttributesSerialize" /><SecurityCapabilities name="Capabilities">0</SecurityCapabilities><bool name="DefinesCapabilities">false</bool><UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId><string name="Name">DebugState</string><BinaryString name="SerializedOverrides" /><int64 name="SourceAssetId">-1</int64><SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString><UniqueId name="UniqueId">2a8c184ef8e375f00b0e761600000f94</UniqueId></Properties></Item><Item class="ModuleScript" referent="RBXC95E11E8C4F441018B93F74BEEA7EDB9"><Properties>
					<Content name="LinkedSource"><null /></Content><ProtectedString name="Source">local Suite={}
local ClassicStadium2D=require(script.Parent:WaitForChild("ClassicStadium2D"))
local MatchRules2D=require(script.Parent:WaitForChild("MatchRules2D"))
local PredictionLab2D=require(game:GetService("ReplicatedStorage").HaxballLab:WaitForChild("PredictionLab2D"))
local StadiumProfile2D=require(game:GetService("ReplicatedStorage").HaxballLab:WaitForChild("StadiumReference2D"))
local function near(a,b,tolerance)
    return math.abs(a-b)&lt;=tolerance
end
local function finite(n)
    return type(n)=="number" and n==n and math.abs(n)&lt;1e12
end
local function addResult(report,name,fn)
    local ok,value=pcall(fn)
    table.insert(report.tests,{
        name=name,passed=ok and value.passed==true,
        detail=ok and value.detail or tostring(value),
    })
end

function Suite.Run(P)
    local report={tickRate=P.Config.tickRate,tests={}}
    addResult(report,"horizontal_free_acceleration_120_ticks",function()
        local s=P.newState();s.player.x=-200;s.player.y=100
        local vx,x=0,-200
        local maxX,maxV=0,0
        for i=1,120 do
            local before=vx+P.Config.playerAcceleration
            x+=before;vx=before*P.Config.playerDamping
            P.step(s,{x=1,y=0,kick=false})
            maxX=math.max(maxX,math.abs(s.player.x-x))
            maxV=math.max(maxV,math.abs(s.player.vx-vx))
        end
        return {passed=maxX&lt;=1e-9 and maxV&lt;=1e-9,detail=string.format("samples=120 maxPositionError=%.3g maxVelocityError=%.3g finalSpeed=%.9f",maxX,maxV,math.abs(vx))}
    end)
    addResult(report,"diagonal_normalization_120_ticks",function()
        local s=P.newState();s.player.x=-200;s.player.y=-150;s.ball.x=300
        local vx,vy,x,y=0,0,-200,-150
        local ux,uy=1/math.sqrt(2),1/math.sqrt(2)
        local maxError=0
        for i=1,120 do
            local nx,ny=vx+P.Config.playerAcceleration*ux,vy+P.Config.playerAcceleration*uy
            x+=nx;y+=ny;vx,vy=nx*P.Config.playerDamping,ny*P.Config.playerDamping
            P.step(s,{x=1,y=1,kick=false})
            maxError=math.max(maxError,math.abs(s.player.x-x),math.abs(s.player.y-y),math.abs(s.player.vx-vx),math.abs(s.player.vy-vy))
        end
        local speed=math.sqrt(s.player.vx*s.player.vx+s.player.vy*s.player.vy)
        return {passed=maxError&lt;=1e-9 and near(speed,2.382103866679,1e-9),detail=string.format("samples=120 maxStateError=%.3g finalSpeed=%.9f",maxError,speed)}
    end)
    addResult(report,"release_damping_30_ticks",function()
        local s=P.newState();s.player.x=-200;s.player.y=100
        for i=1,120 do P.step(s,{x=1,y=0}) end
        local expectedV,expectedX=s.player.vx,s.player.x
        for i=1,30 do expectedX+=expectedV;expectedV*=P.Config.playerDamping;P.step(s,{x=0,y=0}) end
        local xError,vError=math.abs(s.player.x-expectedX),math.abs(s.player.vx-expectedV)
        return {passed=xError&lt;=1e-9 and vError&lt;=1e-9,detail=string.format("samples=30 positionError=%.3g velocityError=%.3g",xError,vError)}
    end)
    addResult(report,"ball_damping_120_ticks",function()
        local s=P.newState();s.player.x=-200;s.player.y=100;s.ball.vx=2
        local x,v=0,2
        for i=1,120 do x+=v;v*=P.Config.ballDamping;P.step(s,{x=0,y=0}) end
        local xError,vError=math.abs(s.ball.x-x),math.abs(s.ball.vx-v)
        return {passed=xError&lt;=1e-9 and vError&lt;=1e-9,detail=string.format("samples=120 positionError=%.3g velocityError=%.3g",xError,vError)}
    end)
    addResult(report,"kick_range_and_impulse",function()
        local s=P.newState();s.player.x=-27
        local accepted=P.tryKick(s,1,0)
        return {passed=accepted and near(s.ball.vx,5,1e-12) and near(s.player.vx,0,1e-12),detail=string.format("accepted=%s ballVx=%.9f playerVx=%.9f",tostring(accepted),s.ball.vx,s.player.vx)}
    end)
    addResult(report,"fast_player_ball_crossing",function()
        local s=P.newState();s.player.x=-40;s.player.vx=100
        local _,info=P.step(s,{x=0,y=0})
        local c=info.lastPlayerBallContact
        local ok=c~=nil and info.playerBallContacts&gt;0 and near(c.normalSpeedBefore,-100,1e-8) and near(c.impulse,100,1e-8) and c.penetration&lt;=2
        return {passed=ok,detail=string.format("substeps=%d contacts=%d contactSubstep=%s penetration=%.6f impulse=%.9f",info.substeps,info.playerBallContacts,tostring(c and c.substep),c and c.penetration or -1,c and c.impulse or -1)}
    end)
    addResult(report,"fast_diagonal_player_ball_contact",function()
        local s=P.newState();s.player.x=-40;s.player.y=-40;s.player.vx=100;s.player.vy=100
        local _,info=P.step(s,{x=0,y=0})
        local c=info.lastPlayerBallContact
        local expected=-1/math.sqrt(2)
        local ok=c~=nil and near(c.normalX,expected,1e-8) and near(c.normalY,expected,1e-8) and c.penetration&lt;=0.5
        return {passed=ok,detail=string.format("substeps=%d normal=(%.6f,%.6f) penetration=%.6f impulse=%.6f",info.substeps,c and c.normalX or 0,c and c.normalY or 0,c and c.penetration or -1,c and c.impulse or -1)}
    end)
    addResult(report,"multiple_ball_wall_bounces_in_one_tick",function()
        local s=P.newState();s.player.y=100;s.ball.vx=3000
        local _,info=P.step(s,{x=0,y=0})
        local xError,vError=math.abs(s.ball.x+172.5),math.abs(s.ball.vx-742.5)
        local ok=info.ballWallBounces==2 and xError&lt;=1e-8 and vError&lt;=1e-8
        return {passed=ok,detail=string.format("bounces=%d substeps=%d x=%.9f vx=%.9f xError=%.3g vError=%.3g",info.ballWallBounces,info.substeps,s.ball.x,s.ball.vx,xError,vError)}
    end)
    addResult(report,"swept_player_pair_crossing",function()
        local s=P.newState();s.player.x=-40;s.player.vx=80;s.player2.x=40;s.player2.vx=-80
        local _,c=P.stepPlayerPair(s)
        local ok=c~=nil and c.swept==true and near(c.impactFraction,0.3125,1e-12) and near(c.impulse,240,1e-9)
        return {passed=ok,detail=string.format("swept=%s toi=%.9f impulse=%.9f",tostring(c and c.swept),c and c.impactFraction or -1,c and c.impulse or -1)}
    end)
    addResult(report,"symmetric_two_player_ball_collision",function()
        local s=P.newState();s.player.x=-32;s.player.vx=2;s.player2.x=32;s.player2.vx=-2
        local a,b
        local residual=math.huge
        for tick=1,12 do
            local _,impacts,_,stepResidual=P.stepThreeBody(s,24)
            residual=stepResidual
            a=impacts["player1-ball"] or a
            b=impacts["player2-ball"] or b
            if a and b then break end
        end
        if not a or not b then
            return {passed=false,detail="no paired contact within 12 ticks"}
        end
        local impulseError=math.abs(a.impulseTotal-b.impulseTotal)
        local velocityError=math.abs(s.player.vx+s.player2.vx)+math.abs(s.ball.vx)
        local ok=impulseError&lt;=1e-3 and residual&lt;=1e-3 and velocityError&lt;=1e-3 and s.player.vx&lt;0 and s.player2.vx&gt;0
        return {passed=ok,detail=string.format("tick=%d impulses=(%.9f,%.9f) impulseError=%.3g residual=%.3g velocitySymmetryError=%.3g",s.tick,a.impulseTotal,b.impulseTotal,impulseError,residual,velocityError)}
    end)
    addResult(report,"three_disc_overlap_resolution",function()
        local s=P.newState();s.player.x=-14;s.player2.x=14
        local _,_,_,residual=P.stepThreeBody(s,24)
        local ok=finite(residual) and residual&lt;=1e-3
        return {passed=ok,detail=string.format("firstTickResidual=%.9g",residual)}
    end)
    addResult(report,"coincident_player_centers",function()
        local s=P.newState();s.player.x=0;s.player2.x=0
        P.stepPlayerPair(s)
        local separation=math.abs(s.player.x-s.player2.x)
        local ok=near(separation,30,1e-9) and finite(s.player.x) and finite(s.player2.x)
        return {passed=ok,detail=string.format("positions=(%.9f,%.9f) separation=%.9f",s.player.x,s.player2.x,separation)}
    end)

    local Core=P.MatchCore
    addResult(report,"core_fixed_tick_integration_order",function()
        local w=Core.newWorld()
        Core.addDisc(w,{id=1,kind="player",x=0,y=0,radius=15,invMass=1,damping=0.96,acceleration=0.1})
        Core.stepWorld(w,{[1]={x=1,y=0}})
        local d=w.discs[1]
        local expectedX=0.1
        local expectedV=0.096
        return {passed=near(d.x,expectedX,1e-12) and near(d.vx,expectedV,1e-12),detail=string.format("tick=%d x=%.12f vx=%.12f",w.tick,d.x,d.vx)}
    end)
    addResult(report,"core_diagonal_input_normalization",function()
        local w=Core.newWorld()
        Core.addDisc(w,{id=1,kind="player",radius=15,invMass=1,damping=1,acceleration=0.1})
        Core.stepWorld(w,{[1]={x=1,y=1}})
        local d=w.discs[1]
        local expected=0.1/math.sqrt(2)
        return {passed=near(d.vx,expected,1e-12) and near(d.vy,expected,1e-12),detail=string.format("vx=%.12f vy=%.12f",d.vx,d.vy)}
    end)
    addResult(report,"core_disc_collision_product_restitution",function()
        local w=Core.newWorld({fieldHalfWidth=1000,fieldHalfHeight=1000})
        Core.addDisc(w,{id=1,kind="player",x=-9,vx=1,radius=10,invMass=1,damping=1,bCoef=0.5})
        Core.addDisc(w,{id=2,kind="ball",x=9,vx=-1,radius=10,invMass=1,damping=1,bCoef=0.5})
        Core.stepWorld(w,{})
        local a,b=w.discs[1],w.discs[2]
        local expectedA,expectedB=-0.25,0.25
        return {passed=near(a.vx,expectedA,1e-12) and near(b.vx,expectedB,1e-12) and #w.events==1,detail=string.format("vx=(%.12f,%.12f) contactEvents=%d",a.vx,b.vx,#w.events)}
    end)
    addResult(report,"core_collision_masks_exclude_pair",function()
        local w=Core.newWorld({fieldHalfWidth=1000,fieldHalfHeight=1000})
        Core.addDisc(w,{id=1,x=-9,vx=1,radius=10,invMass=1,damping=1,collisionGroup=1,collisionMask=1})
        Core.addDisc(w,{id=2,x=9,vx=-1,radius=10,invMass=1,damping=1,collisionGroup=2,collisionMask=2})
        Core.stepWorld(w,{})
        return {passed=#w.events==0 and w.discs[1].x==-8 and w.discs[2].x==8,detail=string.format("contacts=%d positions=(%.3f,%.3f)",#w.events,w.discs[1].x,w.discs[2].x)}
    end)
    addResult(report,"core_kick_edge_only_once",function()
        local w=Core.newWorld()
        Core.addDisc(w,{id=1,kind="player",x=-20,radius=15,invMass=1,damping=1,kickStrength=5,kickback=0,kickRangeExtra=4})
        Core.addDisc(w,{id=2,kind="ball",x=0,radius=10,invMass=1,damping=1,kickable=true})
        Core.stepWorld(w,{[1]={x=0,y=0,kick=true}})
        local first=w.discs[2].vx
        local firstKickEvent=w.events[1] and w.events[1].kind=="kick"
        Core.stepWorld(w,{[1]={x=0,y=0,kick=true}})
        local second=w.discs[2].vx
        local repeatedKickEvent=false
        for _,event in ipairs(w.events) do if event.kind=="kick" then repeatedKickEvent=true end end
        return {passed=near(first,5,1e-12) and near(second,5,1e-12) and firstKickEvent and not repeatedKickEvent,detail=string.format("ballVx=%.3f-&gt;%.3f kickEventFirst=%s repeated=%s",first,second,tostring(firstKickEvent),tostring(repeatedKickEvent))}
    end)
    addResult(report,"core_ten_player_classic_world_600_ticks",function()
        local w=Core.newWorld({useBounds=false})
        Core.addDisc(w,{id="ball",kind="ball",radius=10,invMass=1,damping=0.99,bCoef=0.5,kickable=true,collisionGroup=ClassicStadium2D.Groups.ball})
        local geometry=ClassicStadium2D.install(Core,w)
        local positions={{-80,0},{-150,-54},{-150,-18},{-150,18},{-150,54},{150,-72},{150,-36},{150,0},{150,36},{150,72}}
        local red,blue=0,0
        for i=1,10 do
            local team=i&lt;=5 and "red" or "blue"
            if team=="red" then red+=1 else blue+=1 end
            local p=positions[i]
            Core.addDisc(w,{id=i,kind="player",team=team,x=p[1],y=p[2],radius=15,invMass=0.5,damping=0.96,bCoef=0.5,acceleration=0.1,kickAcceleration=0.07,kickStrength=5,kickback=0,collisionGroup=team=="red" and ClassicStadium2D.Groups.red or ClassicStadium2D.Groups.blue,collisionMask=require(game:GetService("ReplicatedStorage").HaxballLab.StadiumReference2D).CollisionMasks.player})
        end
        local totalEvents,maxSubsteps=0,0
        local valid=true
        for tick=1,600 do
            local inputs={}
            for i=1,10 do inputs[i]={x=math.sin(tick*0.013+i),y=math.cos(tick*0.017-i),kick=(tick%97==1)} end
            local _,tickEvents,substeps=Core.stepWorld(w,inputs)
            totalEvents+=#tickEvents
            maxSubsteps=math.max(maxSubsteps,substeps)
        end
        valid=w.tick==600 and #w.discs==15 and red==5 and blue==5 and geometry.planes==6 and geometry.segments==14 and geometry.posts==4 and totalEvents&gt;0
        for _,d in ipairs(w.discs) do
            valid=valid and finite(d.x) and finite(d.y) and finite(d.vx) and finite(d.vy)
            if d.kind=="player" then valid=valid and math.abs(d.x)&lt;=405 and math.abs(d.y)&lt;=185 end
        end
        local ball=w.discById["string:ball"]
        valid=valid and math.abs(ball.x)&lt;=410 and math.abs(ball.y)&lt;=190
        return {passed=valid,detail=string.format("ticks=%d players=%d red=%d blue=%d discs=%d events=%d maxSubsteps=%d finite=%s",w.tick,red+blue,red,blue,#w.discs,totalEvents,maxSubsteps,tostring(valid))}
    end)
    addResult(report,"core_dense_ten_disc_overlap_relaxes",function()
        local w=Core.newWorld({useBounds=false})
        Core.addDisc(w,{id=0,kind="ball",radius=10,invMass=1,damping=0.99,kickable=true})
        for i=1,10 do
            Core.addDisc(w,{id=i,kind="player",x=((i-1)%5)*8-16,y=(i&lt;=5 and -4 or 4),radius=15,invMass=0.5,damping=0.96})
        end
        local initialMax,finalMax=0,0
        local valid=true
        for tick=1,120 do
            Core.stepWorld(w,{})
            local maxOverlap=0
            for i=1,#w.discs-1 do
                for j=i+1,#w.discs do
                    local a,b=w.discs[i],w.discs[j]
                    local overlap=a.radius+b.radius-math.sqrt((a.x-b.x)^2+(a.y-b.y)^2)
                    maxOverlap=math.max(maxOverlap,overlap)
                    valid=valid and finite(a.x) and finite(a.y) and finite(a.vx) and finite(a.vy)
                end
            end
            if tick==1 then initialMax=maxOverlap end
            if tick==120 then finalMax=maxOverlap end
        end
        local ok=valid and initialMax&gt;20 and finalMax&lt;=1e-3
        return {passed=ok,detail=string.format("ticks=120 initialMaxOverlap=%.6f finalMaxOverlap=%.3g finite=%s",initialMax,finalMax,tostring(valid))}
    end)
    addResult(report,"core_replay_deterministic",function()
        local function run()
            local w=Core.newWorld()
            Core.addDisc(w,{id=1,kind="player",x=-30,radius=15,invMass=0.5,damping=0.96,acceleration=0.1})
            Core.addDisc(w,{id=2,kind="ball",radius=10,invMass=1,damping=0.99,kickable=true})
            for tick=1,240 do Core.stepWorld(w,{[1]={x=tick%30&lt;15 and 1 or -1,y=tick%40&lt;20 and 0.5 or -0.5,kick=tick%61==1}}) end
            return Core.snapshot(w)
        end
        local a,b=run(),run()
        local exact=a.tick==b.tick and #a.discs==#b.discs
        for i=1,#a.discs do
            for _,key in ipairs({"x","y","vx","vy"}) do exact=exact and a.discs[i][key]==b.discs[i][key] end
        end
        return {passed=exact,detail=string.format("ticks=%d discs=%d exact=%s",a.tick,#a.discs,tostring(exact))}
    end)
    addResult(report,"core_boundary_clamp_and_bounce",function()
        local w=Core.newWorld({fieldHalfWidth=50,fieldHalfHeight=50})
        Core.addDisc(w,{id=1,kind="ball",x=35,vx=20,radius=10,invMass=1,damping=1,bCoef=0.5})
        Core.stepWorld(w,{})
        local d=w.discs[1]
        return {passed=near(d.x,35,1e-12) and near(d.vx,-10,1e-12),detail=string.format("x=%.3f vx=%.3f",d.x,d.vx)}
    end)
