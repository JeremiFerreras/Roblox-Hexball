        local w=Core.newWorld({useBounds=false})
        Core.addPlane(w,{id="left",normalX=1,normalY=0,offset=-20,bCoef=0.5})
        Core.addDisc(w,{id=1,kind="ball",x=-15,vx=-5,radius=10,invMass=1,damping=1,bCoef=0.5})
        Core.stepWorld(w,{})
