			<bool name="LoadStringEnabled">false</bool><BinaryString name="AttributesSerialize" /><SecurityCapabilities name="Capabilities">0</SecurityCapabilities><bool name="DefinesCapabilities">false</bool><UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId><string name="Name">ServerScriptService</string><BinaryString name="SerializedOverrides" /><int64 name="SourceAssetId">-1</int64><SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString><UniqueId name="UniqueId">696819431a01660b0b0e2950000003c1</UniqueId></Properties><Item class="Script" referent="RBX4D13436852D24E9D8F6C3D0AFF3B600B"><Properties>
