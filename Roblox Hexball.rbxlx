</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXPhase4StadiumRender2D"><Properties><string name="Name">StadiumRender2D</string><ProtectedString name="Source">-- Pure geometry sampling; rendering never participates in the physical simulation.
local Render = {}
function Render.segmentPoints(segment, angularStep)
	angularStep = angularStep or math.pi / 48
	assert(angularStep &gt; 0 and angularStep &lt; math.pi, "invalid angular step")
	if not segment.curveF then
		return { { x = segment.x1, y = segment.y1 }, { x = segment.x2, y = segment.y2 } }
	end
	local angle = math.atan2(segment.y1 - segment.centerY, segment.x1 - segment.centerX)
	local sweep = segment.curveF == 0 and math.pi or 2 * math.atan(1 / segment.curveF)
	local count = math.ceil(math.abs(sweep) / angularStep)
	local points = {}
	for i = 0, count do
		local a = angle + sweep * i / count
		table.insert(points, {
			x = segment.centerX + segment.arcRadius * math.cos(a),
			y = segment.centerY + segment.arcRadius * math.sin(a),
		})
	end
	-- Keep endpoints exact to avoid visible joins separating through rounding.
	points[1] = { x = segment.x1, y = segment.y1 }
	points[#points] = { x = segment.x2, y = segment.y2 }
	return points
end
function Render.toWorld(x, y, presentation)
	local p = presentation
	return {
		x = p.worldOrigin.x + (x - p.logicalOrigin.x) * p.studsPerUnit,
		y = p.floorY,
		z = p.worldOrigin.z + (p.invertLogicalY and -1 or 1) * (y - p.logicalOrigin.y) * p.studsPerUnit,
	}
end
function Render.cameraHeight(presentation, bounds, fovDegrees, width, height)
	assert(fovDegrees &gt; 0 and fovDegrees &lt; 180, "invalid field of view")
	local aspect = (width and height and width &gt; 0 and height &gt; 0) and width / height or 16 / 9
	local halfWidth = (bounds.maxX - bounds.minX) * presentation.studsPerUnit * 0.5 + 10
	local halfHeight = (bounds.maxY - bounds.minY) * presentation.studsPerUnit * 0.5 + 10
	local tangent = math.tan(math.rad(fovDegrees) * 0.5)
	return presentation.floorY + math.max(halfHeight / tangent, halfWidth / (aspect * tangent))
end
return Render
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXPhase5NetCodec"><Properties><string name="Name">NetCodec</string><ProtectedString name="Source">-- Versioned wire format. State is lossless f64; rendering precision is not physics precision.
local Codec = { VERSION = 1, STATE_BYTES = 482, MAX_COMMANDS = 8 }
local phases = { playing = 1, kickoff = 2, goalPause = 3, finished = 4 }
local phaseNames = { [1] = "playing", [2] = "kickoff", [3] = "goalPause", [4] = "finished" }
local function finite(v)
	return type(v) == "number" and v == v and math.abs(v) &lt; 1e6
end
local function integer(v, max)
	return type(v) == "number" and v == v and v &gt;= 0 and v % 1 == 0 and v &lt;= max
end
local function team(t)
	return t == "red" and 1 or t == "blue" and 2 or 0
end
local function teamName(n)
	return n == 1 and "red" or n == 2 and "blue" or nil
end
function Codec.mask(x, y, kick)
	-- Digital Haxball controls. Opposite keys cancel before encoding.
	return (x &lt; 0 and 1 or x &gt; 0 and 2 or 0) + (y &lt; 0 and 4 or y &gt; 0 and 8 or 0) + (kick and 16 or 0)
end
function Codec.input(mask)
	local x = bit32.band(mask, 2) ~= 0 and 1 or bit32.band(mask, 1) ~= 0 and -1 or 0
	local y = bit32.band(mask, 8) ~= 0 and 1 or bit32.band(mask, 4) ~= 0 and -1 or 0
	return { x = x, y = y, kick = bit32.band(mask, 16) ~= 0 }
end
local function validMask(mask)
	return integer(mask, 31) and bit32.band(mask, 3) ~= 3 and bit32.band(mask, 12) ~= 12
end
function Codec.encodeInput(matchId, round, commands)
	assert(integer(matchId, 4294967295) and integer(round, 4294967295))
	assert(#commands &gt;= 1 and #commands &lt;= Codec.MAX_COMMANDS)
	local b = buffer.create(12 + 9 * #commands)
	buffer.writeu8(b, 0, 1)
	buffer.writeu8(b, 1, 1)
	buffer.writeu16(b, 2, #commands)
	buffer.writeu32(b, 4, matchId)
	buffer.writeu32(b, 8, round)
	for i, c in ipairs(commands) do
		assert(integer(c.seq, 4294967295) and c.seq &gt; 0 and integer(c.tick, 4294967295) and validMask(c.mask))
		local p = 12 + (i - 1) * 9
		buffer.writeu32(b, p, c.seq)
		buffer.writeu32(b, p + 4, c.tick)
		buffer.writeu8(b, p + 8, c.mask)
	end
	return b
end
function Codec.decodeInput(b)
	if typeof(b) ~= "buffer" or buffer.len(b) &lt; 21 or buffer.len(b) &gt; 84 then
		return nil, "size"
	end
	if buffer.readu8(b, 0) ~= 1 or buffer.readu8(b, 1) ~= 1 then
		return nil, "version"
	end
	local n = buffer.readu16(b, 2)
	if n &lt; 1 or n &gt; 8 or buffer.len(b) ~= 12 + 9 * n then
		return nil, "count"
	end
	local packet = { matchId = buffer.readu32(b, 4), round = buffer.readu32(b, 8), commands = {} }
	for i = 1, n do
		local p = 12 + (i - 1) * 9
		local c = { seq = buffer.readu32(b, p), tick = buffer.readu32(b, p + 4), mask = buffer.readu8(b, p + 8) }
		if c.seq == 0 or not validMask(c.mask) then
			return nil, "command"
		end
		table.insert(packet.commands, c)
	end
	return packet
end
function Codec.encodeState(s)
	assert(s.coreMode and #s.players == 10, "5v5 state required")
	local b = buffer.create(Codec.STATE_BYTES)
	buffer.writeu8(b, 0, 1)
	buffer.writeu8(b, 1, 2)
	buffer.writeu8(b, 2, 11)
	buffer.writeu8(b, 3, assert(phases[s.matchPhase]))
	for _, f in ipairs({ { 4, s.matchId }, { 8, s.round }, { 12, s.tick }, { 16, s.elapsedMatchTicks or 0 } }) do
		assert(integer(f[2], 4294967295))
		buffer.writeu32(b, f[1], f[2])
	end
	assert(integer(s.pauseTicksRemaining, 65535) and integer(s.score.red, 65535) and integer(s.score.blue, 65535))
	buffer.writeu16(b, 20, s.pauseTicksRemaining)
	buffer.writeu8(b, 22, team(s.kickoffTeam))
	buffer.writeu8(b, 23, team(s.winner))
	buffer.writeu16(b, 24, s.score.red)
	buffer.writeu16(b, 26, s.score.blue)
	local touch = s.lastTouch
	buffer.writeu8(b, 28, touch and touch.playerId or 0)
	buffer.writeu8(b, 29, touch and touch.kind == "kick" and 1 or 0)
	buffer.writeu32(b, 30, touch and touch.tick or 0)
	buffer.writeu8(b, 34, touch and team(touch.team) or 0)
	buffer.writeu8(b, 35, s.lastGoal and team(s.lastGoal.team) or 0)
	buffer.writeu32(b, 36, s.lastGoal and s.lastGoal.tick or 0)
	local function body(d, p)
		for i, key in ipairs({ "x", "y", "vx", "vy" }) do
			assert(finite(d[key]))
			buffer.writef64(b, p + (i - 1) * 8, d[key])
		end
	end
	body(s.ball, 40)
	for slot, d in ipairs(s.players) do
		local p = 72 + (slot - 1) * 41
		body(d, p)
		assert(integer(d.ack or 0, 4294967295) and integer(d.kickCooldown or 0, 65535))
		buffer.writeu32(b, p + 32, d.ack or 0)
		buffer.writeu16(b, p + 36, d.kickCooldown or 0)
		buffer.writeu8(b, p + 38, (d.kickHeld and 1 or 0) + (d.kickArmed and 2 or 0) + (d.needsKickRelease and 4 or 0))
		buffer.writeu8(b, p + 39, d.collisionMask)
		buffer.writeu8(b, p + 40, d.inputMask or 0)
	end
	return b
end
function Codec.decodeState(b, base)
	if typeof(b) ~= "buffer" or buffer.len(b) ~= 482 then
		return nil, "size"
	end
	if buffer.readu8(b, 0) ~= 1 or buffer.readu8(b, 1) ~= 2 or buffer.readu8(b, 2) ~= 11 then
		return nil, "version"
	end
	if
		buffer.readu8(b, 22) &gt; 2
		or buffer.readu8(b, 23) &gt; 2
		or buffer.readu8(b, 29) &gt; 1
		or buffer.readu8(b, 34) &gt; 2
		or buffer.readu8(b, 35) &gt; 2
	then
		return nil, "enum"
	end
	local phase = phaseNames[buffer.readu8(b, 3)]
	if not phase or not base or not base.players or #base.players ~= 10 then
		return nil, "bootstrap"
	end
	local s = table.clone(base)
	s.resync = nil
	s.matchId = buffer.readu32(b, 4)
	s.round = buffer.readu32(b, 8)
	s.tick = buffer.readu32(b, 12)
	s.gameTime = s.tick / 60
	s.elapsedMatchTicks = buffer.readu32(b, 16)
	s.matchPhase = phase
	s.pauseTicksRemaining = buffer.readu16(b, 20)
	s.kickoffTeam = teamName(buffer.readu8(b, 22))
	s.winner = teamName(buffer.readu8(b, 23))
	s.score = { red = buffer.readu16(b, 24), blue = buffer.readu16(b, 26) }
	local goalTeam = teamName(buffer.readu8(b, 35))
	local goalTick = buffer.readu32(b, 36)
	s.lastGoal = goalTeam and { team = goalTeam, tick = goalTick } or nil
	if goalTeam and base.lastGoal and base.lastGoal.team == goalTeam and base.lastGoal.tick == goalTick then
		s.lastGoal = table.clone(base.lastGoal)
	end
	local touch = buffer.readu8(b, 28)
	if touch &gt; 10 then
		return nil, "touch"
	end
	s.lastTouch = touch &gt; 0
			and {
				playerId = touch,
				kind = buffer.readu8(b, 29) == 1 and "kick" or "contact",
				tick = buffer.readu32(b, 30),
				team = teamName(buffer.readu8(b, 34)),
			}
		or nil
	if s.matchId ~= base.matchId or s.round ~= base.round then
		return nil, "epoch"
	end
	local function body(original, p)
		local d = table.clone(original)
		for i, key in ipairs({ "x", "y", "vx", "vy" }) do
			d[key] = buffer.readf64(b, p + (i - 1) * 8)
			if not finite(d[key]) then
				return nil
			end
		end
		d.speed = math.sqrt(d.vx * d.vx + d.vy * d.vy)
		return d
	end
	s.ball = body(base.ball, 40)
	if not s.ball then
		return nil, "finite"
	end
	s.players = {}
	for slot, original in ipairs(base.players) do
		local p = 72 + (slot - 1) * 41
		local d = body(original, p)
		if not d then
			return nil, "finite"
		end
		d.ack = buffer.readu32(b, p + 32)
		d.kickCooldown = buffer.readu16(b, p + 36)
		local flags = buffer.readu8(b, p + 38)
		d.kickHeld = bit32.band(flags, 1) ~= 0
		d.kickArmed = bit32.band(flags, 2) ~= 0
		d.needsKickRelease = bit32.band(flags, 4) ~= 0
		d.collisionMask = buffer.readu8(b, p + 39)
		d.inputMask = buffer.readu8(b, p + 40)
		if flags &gt; 7 or not validMask(d.inputMask) then
			return nil, "flags"
		end
		s.players[slot] = d
	end
	s.player = s.players[1]
	s.player2 = s.players[6]
	return s
end
return Codec
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXPhase5NetInputQueue"><Properties><string name="Name">NetInputQueue</string><ProtectedString name="Source">-- One ordered transition per player per authoritative tick, independent of arrival order/FPS.
local Codec = require(script.Parent:WaitForChild("NetCodec"))
local Queue = {}
Queue.__index = Queue
function Queue.new(matchId, round)
	return setmetatable({
		matchId = matchId,
		round = round,
		ack = 0,
		pending = {},
		mask = 0,
		ackMask = 0,
		suspended = false,
		lastSeen = 0,
		budget = 16,
		budgetTick = 0,
		rejected = 0,
	}, Queue)
end
function Queue:receive(b, tick)
	local packet = Codec.decodeInput(b)
	if not packet or packet.matchId ~= self.matchId or packet.round ~= self.round then
		self.rejected += 1
		return false
	end
	self.budget = math.min(16, self.budget + math.max(0, tick - self.budgetTick))
	self.budgetTick = tick
	local new = {}
	local seen = {}
	for _, c in ipairs(packet.commands) do
		if seen[c.seq] then
			self.rejected += 1
			return false
		end
		seen[c.seq] = true
		local old = self.pending[c.seq]
		if old and (old.mask ~= c.mask or old.tick ~= c.tick) then
			self.rejected += 1
			return false
		end
		if c.seq &gt; self.ack and not old then
			if c.seq &gt; self.ack + 32 or c.tick &gt; tick + 120 or c.tick + 600 &lt; tick then
				self.rejected += 1
				return false
			end
			table.insert(new, c)
		end
	end
	if #new &gt; self.budget then
		self.rejected += 1
		return false
	end
	for _, c in ipairs(new) do
		self.pending[c.seq] = c
	end
	if self.suspended then
		for _, c in ipairs(packet.commands) do
			if c.seq == self.ack and c.mask == self.ackMask then
				self.mask = self.ackMask
				self.suspended = false
			end
		end
	end
	self.budget -= #new
	self.lastSeen = tick
	return true
end
function Queue:step(tick)
	local c = self.pending[self.ack + 1]
	if c then
		self.ack = c.seq
		self.mask = c.mask
		self.ackMask = c.mask
		self.suspended = false
		self.pending[c.seq] = nil
	end
	-- Loss/disconnection must not leave a direction or X pressed forever.
	if tick - self.lastSeen &gt; 30 then
		self.mask = 0
		self.suspended = true
	end
	local value = Codec.input(self.mask)
	value.stale = self.suspended or self.ack == 0
	return value
end
return Queue
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXPhase5NetInputClient"><Properties><string name="Name">NetInputClient</string><ProtectedString name="Source">local Codec = require(script.Parent:WaitForChild("NetCodec"))
local Client = {}
Client.__index = Client
function Client.new()
	return setmetatable({
		matchId = nil,
		round = nil,
		seq = 0,
		ack = 0,
		pending = {},
		mask = nil,
		lastSend = -math.huge,
		lastReliable = -math.huge,
	}, Client)
end
function Client:reset(matchId, round, ack)
	self.matchId, self.round, self.seq, self.ack = matchId, round, ack or 0, ack or 0
	self.pending = {}
	self.mask = nil
	self.lastSend = -math.huge
	self.lastReliable = -math.huge
end
function Client:confirm(ack)
	if type(ack) ~= "number" or ack ~= ack or ack % 1 ~= 0 or ack &gt; 4294967295 or ack &lt; self.ack then
		return false
	end
	if ack &gt; self.seq then
		self.seq = ack
		self.pending = {}
		self.mask = nil
	end
	self.ack = ack
	while self.pending[1] and self.pending[1].seq &lt;= ack do
		table.remove(self.pending, 1)
	end
	return true
end
function Client:sample(mask, tick, now)
	if not self.matchId then
		return
	end
	self.lastTick = tick
	if mask ~= self.mask then
		if #self.pending &gt;= 32 then
			return
		end -- bounded backlog, retry current state after acknowledgements
		self.seq += 1
		self.mask = mask
		table.insert(self.pending, { seq = self.seq, tick = tick, mask = mask, created = now })
	end
end
function Client:packet(now)
	if not self.matchId or self.seq == 0 or now - self.lastSend &lt; 1 / 60 - 1e-6 then
		return nil
	end
	local hasPending = #self.pending &gt; 0
	if not hasPending and now - self.lastSend &lt; 0.1 then
		return nil
	end
	local commands = {}
	for i = 1, math.min(#self.pending, 8) do
		commands[i] = self.pending[i]
	end
	if #commands == 0 then
		commands[1] = { seq = self.seq, tick = self.lastTick or 0, mask = self.mask }
	end
	local b = Codec.encodeInput(self.matchId, self.round, commands)
	self.lastSend = now
	local reliable = hasPending and now - self.pending[1].created &gt;= 0.15 and now - self.lastReliable &gt;= 0.15
	if reliable then
		self.lastReliable = now
	end
	return b, reliable
end
return Client
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXPhase5PhysicsCore2D"><Properties><string name="Name">PhysicsCore2D</string><ProtectedString name="Source">-- Deterministic 2D match core.
-- Logical coordinates use Haxball stadium units. One call to stepWorld is one fixed game tick.
-- Collision order follows the explicit disc insertion order: dynamic pairs, then static geometry per disc.
local Core = {}

local DEFAULTS = {
	tickRate = 60,
	solverMode = "adaptive", -- Explicit compatibility option: haxballDiscrete.
	playerAcceleration = 0.1,
	playerKickAcceleration = 0.07,
	playerDamping = 0.96,
	playerKickDamping = 0.96,
	ballDamping = 0.99,
	defaultBounce = 0.5,
	maxSubsteps = 64,
	kickRangeExtra = 4,
	kickCooldownTicks = 2,
	fieldHalfWidth = 420,
	fieldHalfHeight = 200,
}

local function finite(value)
	return type(value) == "number" and value == value and math.abs(value) &lt; 1e12
end

local function validMask(value)
	return finite(value) and value &gt;= 0 and value &lt;= 0xFFFFFFFF and math.floor(value) == value
end

local function idKey(id)
	return typeof(id) .. ":" .. tostring(id)
end

function Core.newWorld(config)
	config = config or {}
	local settings = table.clone(DEFAULTS)
	for key, value in pairs(config) do
		settings[key] = value
	end
	assert(finite(settings.tickRate) and settings.tickRate &gt; 0, "tickRate must be positive")
	assert(finite(settings.fieldHalfWidth) and settings.fieldHalfWidth &gt; 0, "fieldHalfWidth must be positive")
	assert(finite(settings.fieldHalfHeight) and settings.fieldHalfHeight &gt; 0, "fieldHalfHeight must be positive")
	assert(
		finite(settings.maxSubsteps)
			and settings.maxSubsteps &gt;= 1
			and settings.maxSubsteps &lt;= 256
			and math.floor(settings.maxSubsteps) == settings.maxSubsteps,
		"maxSubsteps must be an integer from 1 to 256"
	)
	assert(settings.solverMode == "adaptive" or settings.solverMode == "haxballDiscrete", "unknown solverMode")
	return {
		tick = 0,
		config = settings,
		discs = {},
		discById = {},
		events = {},
		planes = {},
		segments = {},
		geometryById = {},
		referenceGeometry = nil,
		useBounds = settings.useBounds ~= false,
		lastSubsteps = 0,
		motionSegments = {},
	}
end

function Core.newDisc(spec)
	assert(type(spec) == "table", "disc spec must be a table")
	assert(
		spec.id ~= nil and (type(spec.id) == "number" or type(spec.id) == "string"),
		"disc id must be a number or string"
	)
	local disc = {
		id = spec.id,
		kind = spec.kind or "disc",
		team = spec.team,
		x = spec.x or 0,
		y = spec.y or 0,
		vx = spec.vx or 0,
		vy = spec.vy or 0,
		gravityX = spec.gravityX or 0,
		gravityY = spec.gravityY or 0,
		radius = spec.radius or 10,
		invMass = spec.invMass == nil and 1 or spec.invMass,
		damping = spec.damping == nil and 1 or spec.damping,
		bCoef = spec.bCoef == nil and DEFAULTS.defaultBounce or spec.bCoef,
		collisionGroup = spec.collisionGroup == nil and 1 or spec.collisionGroup,
		collisionMask = spec.collisionMask == nil and 0xFFFFFFFF or spec.collisionMask,
		acceleration = spec.acceleration or DEFAULTS.playerAcceleration,
		kickAcceleration = spec.kickAcceleration or DEFAULTS.playerKickAcceleration,
		kickDamping = spec.kickDamping == nil and (spec.damping or DEFAULTS.playerDamping) or spec.kickDamping,
		kickStrength = spec.kickStrength or 0,
		kickback = spec.kickback or 0,
		kickRangeExtra = spec.kickRangeExtra == nil and DEFAULTS.kickRangeExtra or spec.kickRangeExtra,
		kickable = spec.kickable == true,
		kickHeld = false,
		kickArmed = false,
		kickCooldown = 0,
		maxSpeed = spec.maxSpeed,
		enabled = spec.enabled ~= false,
		traceMotion = spec.traceMotion == true,
	}
	for _, key in ipairs({
		"x",
		"y",
		"vx",
		"vy",
		"gravityX",
		"gravityY",
		"radius",
		"invMass",
		"damping",
		"bCoef",
		"acceleration",
		"kickAcceleration",
		"kickDamping",
		"kickStrength",
		"kickback",
		"kickRangeExtra",
	}) do
		assert(finite(disc[key]), "disc field must be finite: " .. key)
	end
	assert(disc.radius &gt; 0, "disc radius must be positive")
	assert(disc.invMass &gt;= 0, "inverse mass cannot be negative")
	assert(disc.damping &gt;= 0 and disc.kickDamping &gt;= 0, "damping cannot be negative")
	assert(
		validMask(disc.collisionGroup) and validMask(disc.collisionMask),
		"collision flags must be unsigned 32-bit integers"
	)
	if disc.maxSpeed ~= nil then
		assert(finite(disc.maxSpeed) and disc.maxSpeed &gt; 0, "maxSpeed must be positive")
	end
	return disc
end

function Core.addDisc(world, spec)
	assert(type(world) == "table" and type(world.discs) == "table", "invalid world")
	local disc = Core.newDisc(spec)
	local key = idKey(disc.id)
	assert(world.discById[key] == nil, "duplicate disc id: " .. tostring(disc.id))
	world.discById[key] = disc
	-- Insertion order is the solver order; build worlds in their intended physical order.
	table.insert(world.discs, disc)
	return disc
end

function Core.addPlane(world, spec)
	assert(type(spec) == "table" and spec.id ~= nil, "plane id is required")
	local nx, ny = spec.normalX, spec.normalY
	assert(finite(nx) and finite(ny), "plane normal must be finite")
	local length = math.sqrt(nx * nx + ny * ny)
	assert(length &gt; 1e-12, "plane normal cannot be zero")
	local plane = {
		id = spec.id,
		normalX = nx / length,
		normalY = ny / length,
		offset = spec.offset or 0,
		bCoef = spec.bCoef == nil and 0.5 or spec.bCoef,
		collisionGroup = spec.collisionGroup == nil and 1 or spec.collisionGroup,
		collisionMask = spec.collisionMask == nil and 0xFFFFFFFF or spec.collisionMask,
	}
	assert(finite(plane.offset) and finite(plane.bCoef), "plane values must be finite")
	assert(
		validMask(plane.collisionGroup) and validMask(plane.collisionMask),
		"plane collision flags must be unsigned 32-bit integers"
	)
	local key = "plane:" .. idKey(plane.id)
	assert(not world.geometryById[key], "duplicate plane id")
	world.geometryById[key] = true
	table.insert(world.planes, plane)
	return plane
end

local function segmentArcData(x1, y1, x2, y2, curveDegrees)
	if math.abs(curveDegrees) &lt; 1e-9 then
		return nil
	end
	assert(math.abs(curveDegrees) &lt; 360, "segment curve must be between -360 and 360 degrees")
	local dx, dy = x2 - x1, y2 - y1
	local chord = math.sqrt(dx * dx + dy * dy)
	local sweep = math.rad(curveDegrees)
	local half = sweep * 0.5
	local offset
	if math.abs(math.abs(curveDegrees) - 180) &lt; 1e-8 then
		offset = 0
	else
		local tangent = math.tan(half)
		assert(math.abs(tangent) &gt; 1e-12, "invalid curved segment")
		offset = chord / (2 * tangent)
	end
	local midX, midY = (x1 + x2) * 0.5, (y1 + y2) * 0.5
	local leftX, leftY = -dy / chord, dx / chord
	local centerX, centerY = midX + leftX * offset, midY + leftY * offset
	local radius = math.sqrt((x1 - centerX) ^ 2 + (y1 - centerY) ^ 2)
	assert(finite(radius) and radius &gt; 1e-9, "invalid curved segment radius")
	return {
		centerX = centerX,
		centerY = centerY,
		radius = radius,
		startAngle = math.atan2(y1 - centerY, x1 - centerX),
		sweep = sweep,
	}
end

function Core.addSegment(world, spec)
	assert(type(spec) == "table" and spec.id ~= nil, "segment id is required")
	local segment = {
		id = spec.id,
		x1 = spec.x1,
		y1 = spec.y1,
		x2 = spec.x2,
		y2 = spec.y2,
		bCoef = spec.bCoef == nil and 0.5 or spec.bCoef,
		collisionGroup = spec.collisionGroup == nil and 1 or spec.collisionGroup,
		collisionMask = spec.collisionMask == nil and 0xFFFFFFFF or spec.collisionMask,
		twoSided = spec.twoSided ~= false,
		kickoffOnly = spec.kickoffOnly == true,
		curveDegrees = spec.curveDegrees or spec.curve or 0,
	}
	for _, key in ipairs({ "x1", "y1", "x2", "y2", "bCoef", "curveDegrees" }) do
		assert(finite(segment[key]), "segment field must be finite: " .. key)
	end
	assert(
		validMask(segment.collisionGroup) and validMask(segment.collisionMask),
		"segment collision flags must be unsigned 32-bit integers"
	)
	local dx, dy = segment.x2 - segment.x1, segment.y2 - segment.y1
	assert(dx * dx + dy * dy &gt; 1e-16, "segment endpoints must differ")
	local key = "segment:" .. idKey(segment.id)
	assert(not world.geometryById[key], "duplicate segment id")
	world.geometryById[key] = true
	segment.arc = segmentArcData(segment.x1, segment.y1, segment.x2, segment.y2, segment.curveDegrees)
	table.insert(world.segments, segment)
	return segment
end

local function collisionAllowed(a, b)
	return bit32.band(a.collisionGroup, b.collisionMask) ~= 0 and bit32.band(b.collisionGroup, a.collisionMask) ~= 0
end

local function applyInputAndKick(world, inputs, events)
	local cfg = world.config
	for _, player in ipairs(world.discs) do
		if player.enabled and player.kind == "player" then
			local input = inputs[player.id] or inputs[idKey(player.id)] or {}
			if type(input) ~= "table" then
				input = {}
			end
			local ix = finite(input.x) and input.x or 0
			local iy = finite(input.y) and input.y or 0
			local magnitude = math.sqrt(ix * ix + iy * iy)
			if magnitude &gt; 1 then
				ix, iy = ix / magnitude, iy / magnitude
			end

			local kickHeld = input.kick == true
			if kickHeld and not player.kickHeld then
				player.kickArmed = true
			elseif not kickHeld then
				player.kickArmed = false
			end
			player.kickHeld = kickHeld
			if player.kickCooldown &gt; 0 then
				player.kickCooldown -= 1
			end

			if player.kickArmed and player.kickCooldown &lt;= 0 then
				for _, target in ipairs(world.discs) do
					if target.enabled and target.kickable and target.invMass &gt; 0 then
						local dx, dy = target.x - player.x, target.y - player.y
						local distance = math.sqrt(dx * dx + dy * dy)
						local extra = player.kickRangeExtra
						if distance &gt; 0 and distance - player.radius - target.radius &lt; extra then
							local nx, ny = dx / distance, dy / distance
							target.vx += nx * player.kickStrength * target.invMass
							target.vy += ny * player.kickStrength * target.invMass
							player.vx -= nx * player.kickback * player.invMass
							player.vy -= ny * player.kickback * player.invMass
							player.kickArmed = false
							player.kickCooldown = cfg.kickCooldownTicks
							table.insert(events, {
								kind = "kick",
								tick = world.tick + 1,
								playerId = player.id,
								targetId = target.id,
								normalX = nx,
								normalY = ny,
							})
							break
						end
					end
				end
			end

			local accel = player.kickArmed and player.kickAcceleration or player.acceleration
			player.vx += ix * accel
			player.vy += iy * accel
			if player.maxSpeed then
				local speed = math.sqrt(player.vx * player.vx + player.vy * player.vy)
				if speed &gt; player.maxSpeed then
					local scale = player.maxSpeed / speed
					player.vx *= scale
					player.vy *= scale
				end
			end
		end
	end
end

local function resolveBoundsForDisc(world, disc, events, eventKeys)
	if not world.useBounds or not disc.enabled or disc.invMass &lt;= 0 then
		return
	end
	local cfg = world.config
	local minX, maxX = -cfg.fieldHalfWidth + disc.radius, cfg.fieldHalfWidth - disc.radius
	local minY, maxY = -cfg.fieldHalfHeight + disc.radius, cfg.fieldHalfHeight - disc.radius
	local bounceCount = 0
	if disc.x &lt; minX then
		disc.x = minX
		if disc.vx &lt; 0 then
			disc.vx = -disc.vx * disc.bCoef
			bounceCount += 1
		end
	elseif disc.x &gt; maxX then
		disc.x = maxX
		if disc.vx &gt; 0 then
			disc.vx = -disc.vx * disc.bCoef
			bounceCount += 1
		end
	end
	if disc.y &lt; minY then
		disc.y = minY
		if disc.vy &lt; 0 then
			disc.vy = -disc.vy * disc.bCoef
			bounceCount += 1
		end
	elseif disc.y &gt; maxY then
		disc.y = maxY
		if disc.vy &gt; 0 then
			disc.vy = -disc.vy * disc.bCoef
			bounceCount += 1
		end
	end
	if bounceCount &gt; 0 then
		local key = "boundary:" .. idKey(disc.id)
		local event = eventKeys[key]
		if event then
			event.count += bounceCount
		else
			event = { kind = "boundaryContact", tick = world.tick + 1, discId = disc.id, count = bounceCount }
			eventKeys[key] = event
			table.insert(events, event)
		end
	end
end

local function resolveDiscPair(a, b, reference)
	local dx, dy = a.x - b.x, a.y - b.y
	local d2 = dx * dx + dy * dy
	local radii = a.radius + b.radius
	if d2 &gt; radii * radii then
		return nil
	end
	if d2 == 0 and reference then
		return nil
	end

	local distance, nx, ny
	if d2 &gt; 1e-16 then
		distance = math.sqrt(d2)
		nx, ny = dx / distance, dy / distance
	else
		-- Deterministic fallback for coincident centers. Original Haxball behavior
		-- at exact coincidence must still be verified against an official oracle.
		distance = 0
		nx, ny = -1, 0
	end

	local overlap = radii - distance
	local invSum = a.invMass + b.invMass
	if invSum &lt;= 0 then
		return nil
	end
	local mf = a.invMass / invSum
	local shareA = overlap * mf
	a.x += nx * shareA
	a.y += ny * shareA
	local shareB = overlap - shareA
	b.x -= nx * shareB
	b.y -= ny * shareB

	local normalSpeedBefore = nx * (a.vx - b.vx) + ny * (a.vy - b.vy)
	local normalVelocity = normalSpeedBefore
	local impulseMagnitude = 0
	if normalVelocity &lt; 0 then
		-- Haxball-style restitution uses the product of disk bounce coefficients.
		normalVelocity *= (a.bCoef * b.bCoef + 1)
		local changeA = mf * normalVelocity
		a.vx -= nx * changeA
		a.vy -= ny * changeA
		local changeB = normalVelocity - changeA
		b.vx += nx * changeB
		b.vy += ny * changeB
		impulseMagnitude = math.abs(normalVelocity) / invSum
	end
	return {
		normalX = nx,
		normalY = ny,
		penetration = overlap,
		normalSpeedBefore = normalSpeedBefore,
		impulse = impulseMagnitude,
	}
end

local function resolveStaticGeometryForDisc(world, disc, events, eventKeys)
	if not disc.enabled or disc.invMass &lt;= 0 then
		return
	end
	local function collide(geometry, kind, nx, ny, penetration)
		if not collisionAllowed(disc, geometry) or penetration &lt;= 0 then
			return
		end
		disc.x += nx * penetration
		disc.y += ny * penetration
		local normalVelocity = disc.vx * nx + disc.vy * ny
		local impulse = 0
		if normalVelocity &lt; 0 then
			local change = -(1 + disc.bCoef * geometry.bCoef) * normalVelocity
			disc.vx += nx * change
			disc.vy += ny * change
			impulse = change / disc.invMass
		end
		local key = kind .. ":" .. idKey(disc.id) .. ":" .. idKey(geometry.id)
		local event = eventKeys[key]
		if event then
			event.penetration = math.max(event.penetration, penetration)
			event.impulse = math.max(event.impulse, impulse)
		else
			event = {
				kind = kind,
				tick = world.tick + 1,
				discId = disc.id,
				geometryId = geometry.id,
				normalX = nx,
				normalY = ny,
				penetration = penetration,
				impulse = impulse,
			}
			eventKeys[key] = event
			table.insert(events, event)
		end
	end

	for _, plane in ipairs(world.planes) do
		local signed = disc.x * plane.normalX + disc.y * plane.normalY - plane.offset
		local penetration = disc.radius - signed
		if penetration &gt; 0 then
			collide(plane, "planeContact", plane.normalX, plane.normalY, penetration)
		end
	end
	for _, segment in ipairs(world.segments) do
		local qx, qy
		if segment.arc then
			local arc = segment.arc
			local angle = math.atan2(disc.y - arc.centerY, disc.x - arc.centerX)
			local delta = arc.sweep &gt;= 0 and ((angle - arc.startAngle) % (2 * math.pi))
				or ((arc.startAngle - angle) % (2 * math.pi))
			if delta &lt;= math.abs(arc.sweep) + 1e-9 then
				qx = arc.centerX + arc.radius * math.cos(angle)
				qy = arc.centerY + arc.radius * math.sin(angle)
			else
				local dStart = (disc.x - segment.x1) ^ 2 + (disc.y - segment.y1) ^ 2
				local dEnd = (disc.x - segment.x2) ^ 2 + (disc.y - segment.y2) ^ 2
				if dStart &lt;= dEnd then
					qx, qy = segment.x1, segment.y1
				else
					qx, qy = segment.x2, segment.y2
				end
			end
		else
			local sx, sy = segment.x2 - segment.x1, segment.y2 - segment.y1
			local length2 = sx * sx + sy * sy
			local t = math.clamp(((disc.x - segment.x1) * sx + (disc.y - segment.y1) * sy) / length2, 0, 1)
			qx, qy = segment.x1 + t * sx, segment.y1 + t * sy
		end
		local dx, dy = disc.x - qx, disc.y - qy
		local distance2 = dx * dx + dy * dy
		if distance2 &lt; disc.radius * disc.radius then
			local distance, nx, ny
			if distance2 &gt; 1e-16 then
				distance = math.sqrt(distance2)
				nx, ny = dx / distance, dy / distance
			elseif segment.arc then
				local arc = segment.arc
				local angle = arc.startAngle + arc.sweep * 0.5
				nx, ny = math.cos(angle), math.sin(angle)
				distance = 0
			else
				local sx, sy = segment.x2 - segment.x1, segment.y2 - segment.y1
				local length = math.sqrt(sx * sx + sy * sy)
				nx, ny = -sy / length, sx / length
				if not segment.twoSided and (disc.x - segment.x1) * nx + (disc.y - segment.y1) * ny &lt; 0 then
					nx, ny = -nx, -ny
				end
			end
			local allowed = segment.arc ~= nil or segment.twoSided
			if not allowed then
				local sx, sy = segment.x2 - segment.x1, segment.y2 - segment.y1
				local length = math.sqrt(sx * sx + sy * sy)
				allowed = (disc.x - segment.x1) * (-sy / length) + (disc.y - segment.y1) * (sx / length) &gt;= -1e-9
			end
			if allowed then
				collide(segment, "segmentContact", nx, ny, disc.radius - (distance or 0))
			end
		end
	end
end

-- Exact ordered static contact policy for the pinned Node-Haxball 2.3.0
-- compatibility profile. Geometry is numeric reference data, not Roblox objects.
function Core.setReferenceGeometry(world, geometry)
	assert(world.config.solverMode == "haxballDiscrete", "reference geometry requires discrete mode")
	world.referenceGeometry = geometry
end

local function resolveReferenceGeometry(world, d, events)
	local geo = world.referenceGeometry
	if not geo or not d.enabled or d.invMass == 0 then
		return
	end
	local function response(g, nx, ny, penetration, kind)
		d.x += nx * penetration
		d.y += ny * penetration
		local vn = d.vx * nx + d.vy * ny
		if vn &lt; 0 then
			local change = vn * (d.bCoef * g.bCoef + 1)
			d.vx -= nx * change
			d.vy -= ny * change
			table.insert(events, { kind = kind, tick = world.tick + 1, discId = d.id, geometryId = g.id })
		end
	end
	for _, g in ipairs(geo.planes) do
		if collisionAllowed(d, g) then
			local p = g.offset - (g.normalX * d.x + g.normalY * d.y) + d.radius
			if p &gt; 0 then
				response(g, g.normalX, g.normalY, p, "planeContact")
			end
		end
	end
	for _, g in ipairs(geo.segments) do
		if not collisionAllowed(d, g) then
			continue
		end
		local nx, ny, distance
		if g.curveF then
			nx = d.x - g.centerX
			ny = d.y - g.centerY
			local inside = g.v1NormalX * nx + g.v1NormalY * ny &gt; 0 and g.v0NormalX * nx + g.v0NormalY * ny &gt; 0
			if inside == (g.curveF &lt;= 0) then
				continue
			end
			local length = math.sqrt(nx * nx + ny * ny)
			if length == 0 then
				continue
			end
			distance = length - g.arcRadius
			nx /= length
			ny /= length
		else
			local sx, sy = g.x2 - g.x1, g.y2 - g.y1
			if (d.x - g.x1) * sx + (d.y - g.y1) * sy &lt;= 0 or (d.x - g.x2) * sx + (d.y - g.y2) * sy &gt;= 0 then
				continue
			end
			nx, ny = g.normalX, g.normalY
			distance = nx * (d.x - g.x2) + ny * (d.y - g.y2)
		end
		local bias = g.bias or 0
		if bias == 0 then
			if distance &lt; 0 then
				distance = -distance
				nx = -nx
				ny = -ny
			end
		else
			if bias &lt; 0 then
				bias = -bias
				distance = -distance
				nx = -nx
				ny = -ny
			end
			if distance &lt; -bias then
				continue
			end
		end
		if distance &lt; d.radius then
			response(g, nx, ny, d.radius - distance, "segmentContact")
		end
	end
	for _, g in ipairs(geo.vertices) do
		if collisionAllowed(d, g) then
			local nx, ny = d.x - g.x, d.y - g.y
			local distance2 = nx * nx + ny * ny
			if distance2 &gt; 0 and distance2 &lt;= d.radius * d.radius then
				local length = math.sqrt(distance2)
				response(g, nx / length, ny / length, d.radius - length, "vertexContact")
			end
		end
	end
end

function Core.stepWorld(world, inputs)
	assert(type(world) == "table" and type(world.discs) == "table", "invalid world")
	inputs = inputs or {}
	local events, eventKeys = {}, {}
	world.motionSegments = {}
	local traceStarts = {}
	if world.config.solverMode == "haxballDiscrete" then
		for _, disc in ipairs(world.discs) do
			if disc.traceMotion then
				traceStarts[disc.id] = { x = disc.x, y = disc.y }
			end
		end
	end
	applyInputAndKick(world, inputs, events)

	local maxSpeed, minRadius = 0, math.huge
	for _, disc in ipairs(world.discs) do
		if disc.enabled and disc.invMass &gt; 0 then
			maxSpeed = math.max(maxSpeed, math.sqrt(disc.vx * disc.vx + disc.vy * disc.vy))
			minRadius = math.min(minRadius, disc.radius)
		end
	end
	local substeps = 1
	if minRadius &lt; math.huge then
		local maxDistance = math.max(0.5, minRadius * 0.5)
		substeps = math.clamp(math.ceil(maxSpeed / maxDistance), 1, world.config.maxSubsteps)
	end
	local reference = world.config.solverMode == "haxballDiscrete"
	if reference then
		substeps = 1
	end
	world.lastSubsteps = substeps

	-- Adaptive microsteps reduce discrete tunneling while preserving one input,
	-- gravity, and damping application per logical tick.
	for substep = 1, substeps do
		for _, disc in ipairs(world.discs) do
			if disc.enabled and disc.invMass &gt; 0 then
				local startX, startY = disc.x, disc.y
				disc.x += disc.vx / substeps
				disc.y += disc.vy / substeps
				if disc.traceMotion then
					table.insert(world.motionSegments, {
						discId = disc.id,
						x0 = startX,
						y0 = startY,
						x1 = disc.x,
						y1 = disc.y,
						substep = substep,
						substeps = substeps,
					})
				end
			end
		end

		-- The reference advances every position, damps velocities, then resolves contacts.
		if reference then
			for _, disc in ipairs(world.discs) do
				if disc.enabled and disc.invMass &gt; 0 then
					local damping = (disc.kind == "player" and disc.kickArmed) and disc.kickDamping or disc.damping
					disc.vx = (disc.vx + disc.gravityX) * damping
					disc.vy = (disc.vy + disc.gravityY) * damping
				end
			end
		end
		-- Preserve declared solver order inside each microstep.
		for i = 1, #world.discs do
			local a = world.discs[i]
			if a.enabled then
				for j = i + 1, #world.discs do
					local b = world.discs[j]
					if b.enabled and (a.invMass &gt; 0 or b.invMass &gt; 0) and collisionAllowed(a, b) then
						local contact = resolveDiscPair(a, b, reference)
						if contact then
							local key = "pair:" .. idKey(a.id) .. ":" .. idKey(b.id)
							local existing = eventKeys[key]
							if existing then
								existing.penetration = math.max(existing.penetration, contact.penetration)
								existing.impulse = math.max(existing.impulse, contact.impulse)
							else
								contact.kind = "discContact"
								contact.tick = world.tick + 1
								contact.discA = a.id
								contact.discB = b.id
								eventKeys[key] = contact
								table.insert(events, contact)
							end
						end
					end
				end
				resolveBoundsForDisc(world, a, events, eventKeys)
				if reference and world.referenceGeometry then
					resolveReferenceGeometry(world, a, events)
				else
					resolveStaticGeometryForDisc(world, a, events, eventKeys)
				end
			end
		end
	end

	-- Adaptive mode retains its historical post-contact velocity update.
	if not reference then
		for _, disc in ipairs(world.discs) do
			if disc.enabled and disc.invMass &gt; 0 then
				local damping = (disc.kind == "player" and disc.kickArmed) and disc.kickDamping or disc.damping
				disc.vx = (disc.vx + disc.gravityX) * damping
				disc.vy = (disc.vy + disc.gravityY) * damping
			end
		end
	end
	if reference then
		-- Goal crossing uses the completed, corrected tick, like the reference.
		world.motionSegments = {}
		for _, disc in ipairs(world.discs) do
			local start = traceStarts[disc.id]
			if start then
				table.insert(world.motionSegments, {
					discId = disc.id,
					x0 = start.x,
					y0 = start.y,
					x1 = disc.x,
					y1 = disc.y,
					substep = 1,
					substeps = 1,
				})
			end
		end
	end
	world.tick += 1
	world.events = events
	return world, events, substeps
end

function Core.snapshot(world)
	local discs = table.create(#world.discs)
	for index, disc in ipairs(world.discs) do
		discs[index] = {
			id = disc.id,
			kind = disc.kind,
			team = disc.team,
			x = disc.x,
			y = disc.y,
			vx = disc.vx,
			vy = disc.vy,
			radius = disc.radius,
			invMass = disc.invMass,
			damping = disc.damping,
			bCoef = disc.bCoef,
			collisionGroup = disc.collisionGroup,
			collisionMask = disc.collisionMask,
			kickCooldown = disc.kickCooldown,
		}
	end
	return {
		tick = world.tick,
		tickRate = world.config.tickRate,
		substeps = world.lastSubsteps,
		discs = discs,
		events = table.clone(world.events),
	}
end

return Core
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXPhase5NetPrediction"><Properties><string name="Name">NetPrediction</string><ProtectedString name="Source">-- Whole-world prediction: remote players hold their last known input.
-- Predicted contacts/ball motion are visual forecasts; scores are never committed here.
local Core = require(script.Parent:WaitForChild("PhysicsCore2D"))
local Profile = require(script.Parent:WaitForChild("StadiumReference2D"))
local Geometry = require(script.Parent:WaitForChild("ClassicReference230"))
local Codec = require(script.Parent:WaitForChild("NetCodec"))
local Prediction = {}
Prediction.__index = Prediction
function Prediction.new()
	local self = setmetatable(
		{ world = nil, history = {}, forecasts = {}, epoch = nil, correction = 0, reconciliations = 0 },
		Prediction
	)
	return self
end
function Prediction:_world()
	local p = Profile.PhysicsBaseline.active
	local w = Core.newWorld({ useBounds = false, solverMode = "haxballDiscrete" })
	Core.addDisc(w, {
		id = "ball",
		kind = "ball",
		radius = p.ball.radius,
		invMass = p.ball.invMass,
		damping = p.ball.damping,
		bCoef = p.ball.bounce,
		kickable = true,
		collisionGroup = 1,
	})
	Core.setReferenceGeometry(w, Geometry)
	for _, post in ipairs(Geometry.posts) do
		local s = table.clone(post)
		s.kind = "post"
		s.invMass = 0
		s.damping = 1
		Core.addDisc(w, s)
	end
	for slot = 1, 10 do
		Core.addDisc(w, {
			id = slot,
			kind = "player",
			team = slot &lt;= 5 and "red" or "blue",
			radius = p.player.radius,
			invMass = p.player.invMass,
			damping = p.player.damping,
			bCoef = p.player.bounce,
			acceleration = p.player.acceleration,
			kickAcceleration = p.player.kickAcceleration,
			kickDamping = p.player.kickDamping,
			kickStrength = p.player.kickStrength,
			kickback = p.player.kickback,
			collisionGroup = slot &lt;= 5 and 2 or 4,
			collisionMask = 39,
		})
	end
	return w
end
function Prediction:restore(s, slot)
	local epoch = tostring(s.matchId) .. ":" .. s.round .. ":" .. slot
	if self.epoch ~= epoch then
		self.world = self:_world()
		self.history = {}
		self.forecasts = {}
		self.epoch = epoch
		self.correction = 0
	end
	local previous = self.forecasts[s.tick]
	local dx = previous and previous.x - s.players[slot].x or 0
	local dy = previous and previous.y - s.players[slot].y or 0
	self.correction = math.sqrt(dx * dx + dy * dy)
	self.offsetX, self.offsetY = 0, 0
	self.ballOffsetX, self.ballOffsetY = 0, 0
	if self.correction &lt; 10 and s.matchPhase == "playing" then
		self.offsetX, self.offsetY = dx, dy
	end
	if previous and s.matchPhase == "playing" then
		local bx, by = previous.ballX - s.ball.x, previous.ballY - s.ball.y
		if bx * bx + by * by &lt; 100 then
			self.ballOffsetX, self.ballOffsetY = bx, by
		end
	end
	self.reconciliations += 1
	self.slot = slot
	self.phase = s.matchPhase
	self.kickoffTeam = s.kickoffTeam
	self.world.tick = s.tick
	self.confirmedTick = s.tick
	local ball = self.world.discs[1]
	for _, key in ipairs({ "x", "y", "vx", "vy" }) do
		ball[key] = s.ball[key]
	end
	self.lastMasks = {}
	self.release = {}
	for i, d in ipairs(s.players) do
		local p = self.world.discs[5 + i]
		for _, key in ipairs({ "x", "y", "vx", "vy", "kickHeld", "kickArmed", "kickCooldown", "collisionMask" }) do
			p[key] = d[key]
		end
		self.lastMasks[i] = d.inputMask or 0
		self.release[i] = d.needsKickRelease == true
	end
	for tick in pairs(self.history) do
		if tick &lt; s.tick - 2 then
			self.history[tick] = nil
		end
	end
	for tick in pairs(self.forecasts) do
		if tick &lt; s.tick - 2 then
			self.forecasts[tick] = nil
		end
	end
end
function Prediction:advance(targetTick, mask)
	if not self.world or self.phase ~= "playing" then
		return nil
	end
	-- Never extrapolate indefinitely after a stalled/lost stream.
	targetTick = math.min(targetTick, self.confirmedTick + 18)
	while self.world.tick &lt; targetTick do
		local tick = self.world.tick + 1
		local localMask = self.history[tick]
		if localMask == nil then
			localMask = mask
			self.history[tick] = mask
		end
		local inputs = {}
		for i = 1, 10 do
			local value = Codec.input(i == self.slot and localMask or self.lastMasks[i])
			if not value.kick then
				self.release[i] = false
			end
			if self.release[i] or self.kickoffTeam and (i &lt;= 5 and "red" or "blue") ~= self.kickoffTeam then
				value.kick = false
			end
			inputs[i] = value
		end
		local _, events = Core.stepWorld(self.world, inputs)
		for _, e in ipairs(events) do
			local id = e.kind == "kick" and e.playerId or e.discA == "ball" and e.discB or e.discB == "ball" and e.discA
			if type(id) == "number" and self.kickoffTeam and (id &lt;= 5 and "red" or "blue") == self.kickoffTeam then
				local ball = self.world.discs[1]
				if ball.vx ~= 0 or ball.vy ~= 0 then
					self.kickoffTeam = nil
					for i = 1, 10 do
						self.world.discs[5 + i].collisionMask = 39
					end
				end
			end
		end
		local actor = self.world.discs[5 + self.slot]
		self.forecasts[self.world.tick] =
			{ x = actor.x, y = actor.y, ballX = self.world.discs[1].x, ballY = self.world.discs[1].y }
	end
	local actor = self.world.discs[5 + self.slot]
	return actor, self.world.discs[1]
end
function Prediction:visual(actor, ball, dt)
	local factor = math.exp(-math.max(0, dt) / 0.05)
	self.offsetX = (self.offsetX or 0) * factor
	self.offsetY = (self.offsetY or 0) * factor
	self.ballOffsetX = (self.ballOffsetX or 0) * factor
	self.ballOffsetY = (self.ballOffsetY or 0) * factor
	return { x = actor.x + self.offsetX, y = actor.y + self.offsetY }, {
		x = ball.x + self.ballOffsetX,
		y = ball.y + self.ballOffsetY,
	}
end
return Prediction
