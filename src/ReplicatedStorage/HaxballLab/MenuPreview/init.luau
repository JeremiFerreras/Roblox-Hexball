-- Client-local match preview generated by the exact fixed-tick match physics core.
-- The replay is computed once per client runtime and reused; this is neither video nor keyframed art.
local Preview = {}
local cachedReplay = nil
local TICK_RATE = 60
local REPLAY_SECONDS = 15
local MAX_TICKS = TICK_RATE * REPLAY_SECONDS

local RED_ANCHORS = {
	[1] = { x = -155, y = -5 },
	[2] = { x = -82, y = 52 },
	[3] = { x = -82, y = -55 },
	[4] = { x = 25, y = 0 },
}
local BLUE_START = {
	{ x = 116, y = -112 },
	{ x = 220, y = 112 },
	{ x = 252, y = -82 },
	{ x = 340, y = 22 },
}
local PASS_PLAN = {
	-- The central player links short wall-passes through both half-spaces and a runner.
	{ 1, 2 }, { 2, 1 }, { 1, 3 }, { 3, 1 }, { 1, 4 }, { 4, 1 },
}

local function clamp(value, low, high)
	return math.max(low, math.min(high, value))
end

local function distance(ax, ay, bx, by)
	local dx, dy = bx - ax, by - ay
	return math.sqrt(dx * dx + dy * dy)
end

local function speed(disc)
	return math.sqrt(disc.vx * disc.vx + disc.vy * disc.vy)
end

-- PD-style steering produces movement inputs; the physics core still owns velocity,
-- damping, disc contacts, wall contacts, and the actual kick impulse.
local function steer(disc, targetX, targetY, acceleration)
	local dx, dy = targetX - disc.x, targetY - disc.y
	local desiredX = clamp(dx * 0.075, -1.8, 1.8)
	local desiredY = clamp(dy * 0.075, -1.8, 1.8)
	local damping = disc.damping or 1
	local ax = (desiredX - disc.vx * damping) / math.max(acceleration, 1e-4)
	local ay = (desiredY - disc.vy * damping) / math.max(acceleration, 1e-4)
	local magnitude = math.sqrt(ax * ax + ay * ay)
	if magnitude > 1 then
		ax, ay = ax / magnitude, ay / magnitude
	end
	return { x = ax, y = ay, kick = false }
end

local function capture(world, frame)
	for slot = 1, 8 do
		local disc = world.discById["number:" .. tostring(slot)]
		local actor = frame.players[slot]
		actor.x, actor.y = disc.x, disc.y
		actor.vx, actor.vy = disc.vx, disc.vy
	end
	local ball = world.discById["string:ball"]
	frame.ball.x, frame.ball.y = ball.x, ball.y
	frame.ball.vx, frame.ball.vy = ball.vx, ball.vy
end

local function buildReplay(Core, Profile, Reference)
	local baseline = Profile.PhysicsBaseline.active
	local playerPhysics = baseline.player
	local ballPhysics = baseline.ball
	local world = Core.newWorld({
		tickRate = TICK_RATE,
		fieldHalfWidth = Profile.Bounds.halfWidth,
		fieldHalfHeight = Profile.Bounds.halfHeight,
		useBounds = false,
		solverMode = "classicDiscrete",
	})
	Core.addDisc(world, {
		id = "ball",
		kind = "ball",
		x = -130,
		y = -5,
		radius = ballPhysics.radius,
		invMass = ballPhysics.invMass,
		damping = ballPhysics.damping,
		bCoef = ballPhysics.bounce,
		kickable = true,
		collisionGroup = Profile.CollisionGroups.ball,
	})
	Core.setReferenceGeometry(world, Reference)
	for _, post in ipairs(Reference.posts) do
		local spec = table.clone(post)
		spec.kind = "post"
		spec.invMass = 0
		spec.damping = 1
		Core.addDisc(world, spec)
	end

	local players = {}
	for slot = 1, Profile.PlayerCount do
		local team = slot <= Profile.PlayersPerTeam and "red" or "blue"
		local start = team == "red" and RED_ANCHORS[slot] or BLUE_START[slot - Profile.PlayersPerTeam]
		if slot == 1 then
			-- Start on the playable side of the ball, already aligned for the opening pass.
			start = { x = -148, y = -26 }
		end
		local disc = Core.addDisc(world, {
			id = slot,
			kind = "player",
			team = team,
			x = start.x,
			y = start.y,
			radius = playerPhysics.radius,
			invMass = playerPhysics.invMass,
			damping = playerPhysics.damping,
			kickDamping = playerPhysics.kickDamping,
			bCoef = playerPhysics.bounce,
			acceleration = playerPhysics.acceleration,
			kickAcceleration = playerPhysics.kickAcceleration,
			kickStrength = playerPhysics.kickStrength,
			kickback = playerPhysics.kickback,
			kickRangeExtra = baseline.kickRangeExtra,
			collisionGroup = team == "red" and Profile.CollisionGroups.red or Profile.CollisionGroups.blue,
			collisionMask = Profile.CollisionMasks.player,
		})
		players[slot] = disc
	end

	local frames = table.create(MAX_TICKS + 1)
	local initial = {
		players = table.create(8),
		ball = { x = 0, y = 0, vx = 0, vy = 0, radius = ballPhysics.radius, visible = true },
	}
	for slot = 1, 8 do
		initial.players[slot] = {
			id = slot,
			team = slot <= Profile.PlayersPerTeam and "red" or "blue",
			radius = playerPhysics.radius,
			visible = true,
			x = 0, y = 0, vx = 0, vy = 0,
		}
	end
	capture(world, initial)
	frames[1] = initial

	local passIndex = 1
	local holder, receiver = PASS_PLAN[passIndex][1], PASS_PLAN[passIndex][2]
	local passTicks, kicked, receiverContacted, kickCount, receiverContacts = 0, false, false, 0, 0
	local lastKickTick = -1000
	local acceleration = playerPhysics.acceleration
	local kickAcceleration = playerPhysics.kickAcceleration
	local ball = world.discById["string:ball"]
	for tick = 1, MAX_TICKS do
		passTicks += 1
		local target = RED_ANCHORS[receiver]
		local dx, dy = target.x - ball.x, target.y - ball.y
		local length = math.sqrt(dx * dx + dy * dy)
		if length < 1e-6 then
			dx, dy, length = 1, 0, 1
		end
		local dirX, dirY = dx / length, dy / length
		local kickReach = playerPhysics.radius + ballPhysics.radius + baseline.kickRangeExtra - 1
		local stagingX = ball.x - dirX * kickReach
		local stagingY = ball.y - dirY * kickReach

		local inputs = {}
		for slot = 1, Profile.PlayersPerTeam do
			local disc = players[slot]
			local anchor = RED_ANCHORS[slot]
			local goalX, goalY = anchor.x, anchor.y
			if slot == holder then
				goalX, goalY = stagingX, stagingY
			elseif slot == receiver then
				goalX, goalY = target.x, target.y
			else
				-- Supporting players open passing lanes without snapping to authored poses.
				goalX = anchor.x + clamp((ball.x - anchor.x) * 0.10, -18, 18)
				goalY = anchor.y + clamp((ball.y - anchor.y) * 0.08, -14, 14)
			end
			inputs[slot] = steer(disc, goalX, goalY, slot == holder and kickAcceleration or acceleration)
		end

		-- Defenders shift as a compact line toward the ball, so the preview has real
		-- 4v4 pressure and occasional contact instead of four stationary decorations.
		for index = 1, 4 do
			local slot = index + Profile.PlayersPerTeam
			local disc = players[slot]
			local lane = ({ -1, 1, -0.3, 0.3 })[index]
			local defendX = clamp(170 + (index - 2.5) * 30, 75, 350)
			local defendY = clamp(ball.y + lane * 66, -145, 145)
			inputs[slot] = steer(disc, defendX, defendY, acceleration)
		end

		local holderDisc = players[holder]
		local holderDistance = distance(holderDisc.x, holderDisc.y, ball.x, ball.y)
		if not kicked and speed(ball) < 3.8 and holderDistance <= playerPhysics.radius + ballPhysics.radius + baseline.kickRangeExtra
			and distance(holderDisc.x, holderDisc.y, stagingX, stagingY) < 9 then
			inputs[holder].kick = true
		end

		local _, events = Core.stepWorld(world, inputs)
		for _, event in ipairs(events) do
			if event.kind == "kick" and event.playerId == holder and event.targetId == "ball" then
				kicked = true
				kickCount += 1
				lastKickTick = tick
			elseif event.kind == "discContact" then
				local touchedReceiver = (event.discA == "ball" and event.discB == receiver)
					or (event.discB == "ball" and event.discA == receiver)
				if touchedReceiver and kicked then
					receiverContacted = true
					receiverContacts += 1
				end
			end
		end

		local receiverDisc = players[receiver]
		local ballAtReceiver = distance(ball.x, ball.y, receiverDisc.x, receiverDisc.y)
			<= playerPhysics.radius + ballPhysics.radius + 5
		if kicked and (receiverContacted or tick - lastKickTick >= 105) or passTicks >= 180 then
			passIndex = passIndex % #PASS_PLAN + 1
			holder, receiver = PASS_PLAN[passIndex][1], PASS_PLAN[passIndex][2]
			passTicks, kicked, receiverContacted = 0, false, false
		end

		local frame = {
			players = table.create(8),
			ball = { x = 0, y = 0, vx = 0, vy = 0, radius = ballPhysics.radius, visible = true },
		}
		for slot = 1, 8 do
			frame.players[slot] = {
				id = slot,
				team = slot <= Profile.PlayersPerTeam and "red" or "blue",
				radius = playerPhysics.radius,
				visible = true,
				x = 0, y = 0, vx = 0, vy = 0,
			}
		end
		capture(world, frame)
		frames[tick + 1] = frame
	end

	assert(#frames == MAX_TICKS + 1, "menu physics replay has an incomplete timeline")
	return {
		frames = frames,
		duration = MAX_TICKS / TICK_RATE,
		tickRate = TICK_RATE,
		stats = {
			simulatedTicks = MAX_TICKS,
			successfulPasses = kickCount,
			receiverContacts = receiverContacts,
		},
		sampleFrame = {
			players = table.create(8),
			ball = { x = 0, y = 0, vx = 0, vy = 0, radius = ballPhysics.radius, visible = true },
		},
	}
end

function Preview.getReplay(Core, Profile, Reference)
	if cachedReplay then
		return cachedReplay
	end
	assert(Core and Profile and Reference, "physics core, stadium profile and collision reference are required")
	cachedReplay = buildReplay(Core, Profile, Reference)
	return cachedReplay
end

function Preview.sample(replay, elapsedSeconds)
	assert(type(replay) == "table" and type(replay.frames) == "table", "a built physics replay is required")
	local duration = replay.duration
	local wrapped = elapsedSeconds % duration
	local position = wrapped * replay.tickRate
	local firstIndex = math.floor(position) + 1
	local alpha = position - math.floor(position)
	local a = replay.frames[firstIndex]
	local b = replay.frames[math.min(firstIndex + 1, #replay.frames)]
	local output = replay.sampleFrame

	for slot = 1, 8 do
		local from = a.players[slot]
		local to = b.players[slot]
		local actor = output.players[slot]
		if not actor then
			actor = { id = slot, team = from.team, radius = from.radius, visible = true }
			output.players[slot] = actor
		end
		actor.x = from.x + (to.x - from.x) * alpha
		actor.y = from.y + (to.y - from.y) * alpha
		actor.vx = from.vx + (to.vx - from.vx) * alpha
		actor.vy = from.vy + (to.vy - from.vy) * alpha
		actor.team = from.team
		actor.radius = from.radius
		actor.visible = true
	end
	local fromBall, toBall = a.ball, b.ball
	output.ball.x = fromBall.x + (toBall.x - fromBall.x) * alpha
	output.ball.y = fromBall.y + (toBall.y - fromBall.y) * alpha
	output.ball.vx = fromBall.vx + (toBall.vx - fromBall.vx) * alpha
	output.ball.vy = fromBall.vy + (toBall.vy - fromBall.vy) * alpha
	output.ball.radius = fromBall.radius
	output.ball.visible = true
	return output
end

return Preview
